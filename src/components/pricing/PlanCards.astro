---
import { PLANS, PLAN_FEATURES, planPrice, planYearly } from "../../data/site";

/** L'en-tête condensé et la grille vivent dans le MÊME composant, et ce n'est pas
 *  un choix de rangement : la bascule mensuel/annuel est en CSS pur (`:has()`), donc
 *  les boutons radio et les prix qu'ils commandent doivent partager un ancêtre.
 *  Les séparer imposerait un sélecteur global sur `html` ou un script. */

/** Le coin corné. 30px de côté, repris tel quel par le clip et par le rabat —
 *  les deux doivent bouger ensemble ou la pliure ne tombe plus juste. */
const EAR = 30;
---

<section class="plans" aria-labelledby="pricing-title">
  <div class="container-wide">
    {/* En-tête sur une seule rangée : titre à gauche, bascule à droite. C'est ce
        qui fait tenir la carte entière au-dessus de la ligne de flottaison sur un
        portable de ~800px. Budget : 64 (nav) + ~150 (en-tête) + ~520 (carte). */}
    <div class="head">
      <div class="head-copy">
        <p class="label-mono text-hour">Pricing</p>
        <h1 id="pricing-title">One bill for the whole workday.</h1>
        <p class="lede">
          Per user, per month. Everything a service team was paying four vendors for - timers,
          monitoring, CRM, projects and docs - on one line.
        </p>
      </div>

      {/* Deux boutons radio, pas deux boutons : la bascule est un choix parmi deux,
          l'état vit dans le DOM et les flèches du clavier fonctionnent sans code.
          Aucun JS n'est chargé pour cette page — le mensuel est rendu côté serveur,
          l'annuel n'attend qu'une case cochée. */}
      <fieldset class="seg">
        <legend class="sr-only">Billing period</legend>

        <input class="sr-only seg-input" type="radio" name="billing" id="billing-monthly" checked />
        <label class="seg-tab" for="billing-monthly">Monthly</label>

        <input class="sr-only seg-input" type="radio" name="billing" id="billing-annual" />
        <label class="seg-tab" for="billing-annual">
          Annual <span class="seg-off">−20%</span>
        </label>
      </fieldset>
    </div>

    <ul class="grid">
      {
        PLANS.map((plan, i) => (
          /* `--i` ne sert qu'au décalage du pli d'une carte à l'autre. Le rang est
             une donnée de mise en page, pas de contenu : il vit sur l'élément. */
          <li class:list={["shell", { "shell--featured": plan.featured }]} style={`--i:${i}`}>
            <article class:list={["card", { "card--featured": plan.featured }]}>
              {/* Le rabat. Purement graphique : la moitié qui dépasse du clip est
                  rognée, il ne reste que le triangle de la pliure. */}
              <span class="ear" aria-hidden="true" />

              <div class="card-head">
                <h2 class="card-name">{plan.name}</h2>
                {plan.featured && <span class="chip">MOST TEAMS</span>}
              </div>

              {/* Les deux tarifs occupent la MÊME cellule de grille : ils se
                  fondent l'un dans l'autre au lieu de se remplacer, et la carte est
                  dimensionnée sur le plus large des deux en permanence — la bascule
                  ne peut donc rien décaler. */}
              <div class="rates">
                {plan.monthly == null ? (
                  <div class="rate">
                    <p class="rate-row">
                      <span class="amount">{planPrice(plan)}</span>
                    </p>
                    {/* Espace insécable : la ligne de facturation n'a rien à dire ici
                        mais doit garder sa hauteur, sinon la carte se décale. */}
                    <p class="billed" aria-hidden="true">
                      &nbsp;
                    </p>
                  </div>
                ) : (
                  <>
                    {/* Un bloc complet par mode plutôt qu'un prix réécrit : chacun se
                        lit seul à voix haute (« $6 /user/mo, $72 billed yearly ») et
                        celui qui est masqué sort de l'arbre d'accessibilité. */}
                    <div class="rate" data-rate="monthly">
                      <p class="rate-row">
                        <span class="amount">{planPrice(plan)}</span>
                        <span class="per">/user/mo</span>
                      </p>
                      <p class="billed">billed monthly</p>
                    </div>

                    <div class="rate" data-rate="annual">
                      <p class="rate-row">
                        <s class="was">{planPrice(plan)}</s>
                        <span class="amount">{planPrice(plan, true)}</span>
                        <span class="per">/user/mo</span>
                      </p>
                      <p class="billed">${planYearly(plan)} billed yearly</p>
                    </div>
                  </>
                )}
              </div>

              <p class="note">{plan.pricingNote}</p>

              <div class="dash" aria-hidden="true" />

              {/* Même liste sur les quatre cartes : ce qui se compare, c'est la
                  colonne de pastilles, pas des arguments différents par plan. */}
              <ul class="feats">
                {PLAN_FEATURES.map((feature, i) => {
                  const on = i < plan.included;
                  return (
                    <li class:list={["feat", { "feat--off": !on }]}>
                      {/* La pastille est décorative : le sens passe par le texte
                          masqué juste après, jamais par la couleur seule. */}
                      <span class="mark" aria-hidden="true">
                        {on ? "✓" : "✕"}
                      </span>
                      <span class="sr-only">{on ? "Included:" : "Not included:"}</span>
                      <span class="feat-text">{feature}</span>
                    </li>
                  );
                })}
              </ul>

              <a
                class="cta"
                href={`/signup?plan=${plan.name.toLowerCase()}`}
                aria-label={`${plan.cta} - ${plan.name}`}
              >
                {plan.cta}
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="beta">
      <span>Beta pricing - subject to change</span>
    </p>
  </div>
</section>

<style define:vars={{ ear: `${EAR}px` }}>
  .plans {
    padding: 28px 0 40px;
  }

  /* ---- En-tête condensé ---- */

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 20px;
  }

  .head h1 {
    margin: 8px 0;
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.02;
    text-wrap: balance;
  }

  .lede {
    max-width: 66ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-slate);
  }

  /* ---- Bascule mensuel / annuel ---- */

  .seg {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 4px;
    margin: 0;
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: #fff;
    padding: 4px;
  }

  .seg-tab {
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-slate);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .seg-tab:hover {
    color: var(--color-ink);
  }

  .seg-input:checked + .seg-tab {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* L'input est masqué visuellement : sans ça l'anneau de focus se poserait sur
     un carré de 1px hors écran et la navigation au clavier serait aveugle. */
  .seg-input:focus-visible + .seg-tab {
    outline: 2px solid var(--color-hour);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--color-ink);
  }

  .seg-off {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* ---- Grille ---- */

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: stretch;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- La carte cornée ---- */

  /* Le `clip-path` rogne TOUT le rendu de l'élément, ombre portée comprise : une
     `box-shadow` posée sur la carte n'apparaîtrait jamais. L'ombre vit donc sur
     l'enveloppe, en `drop-shadow`, ce qui a l'avantage de suivre la silhouette
     cornée au lieu de retracer un rectangle. Même argument que le reçu. */
  .shell {
    display: flex;
    filter: drop-shadow(0 1px 1px rgb(15 21 36 / 0.05));
  }

  .shell--featured {
    filter: drop-shadow(0 22px 24px rgb(15 21 36 / 0.42));
  }

  .card {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    position: relative;
    border: 1px solid var(--color-rule);
    border-radius: 18px;
    background: #fff;
    padding: 22px 22px 20px;
    /* Le coin haut-droit est coupé en biais ; les autres gardent le rayon, que le
       polygone n'atteint pas. */
    clip-path: polygon(0 0, calc(100% - var(--ear)) 0, 100% var(--ear), 100% 100%, 0 100%);
  }

  .card--featured {
    border-color: transparent;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .ear {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--ear);
    height: var(--ear);
    border-radius: 0 0 0 10px;
    /* Gris du rabat : la face arrière de la page, plus froide que le blanc de la
       carte. Valeur locale du handoff — elle n'a de sens que pour cette pliure. */
    background: #e4e8ee;
    box-shadow: -2px 2px 4px rgb(15 21 36 / 0.15);
    /* Le pli part du coin : c'est le même point d'origine que l'encoche du
       `clip-path`, sinon les deux ne grandissent pas ensemble. */
    transform-origin: 100% 0;
  }

  .card--featured .ear {
    background: var(--color-hour);
  }

  /* ---- Identité ---- */

  .card-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .chip {
    border-radius: 999px;
    background: var(--color-hour);
    padding: 3px 7px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    white-space: nowrap;
  }

  /* ---- Prix ---- */

  .rates {
    display: grid;
    margin-top: 10px;
  }

  /* Les deux tarifs sont empilés dans la même cellule. `visibility` plutôt que
     `display: none` : elle sort bien celui qui est caché de l'arbre
     d'accessibilité, mais elle se transitionne — c'est ce qui permet le fondu. */
  .rate {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s ease,
      visibility 0.2s;
  }

  /* Le mode annuel est un doublon du mode mensuel, pas un contenu que le script
     révèle : sans `:has()`, la page reste sur le tarif mensuel, complet et lisible.
     Rien n'est jamais masqué qui ne soit affiché ailleurs. */
  .rate[data-rate="annual"] {
    opacity: 0;
    visibility: hidden;
  }

  .plans:has(#billing-annual:checked) .rate[data-rate="annual"] {
    opacity: 1;
    visibility: visible;
  }

  .plans:has(#billing-annual:checked) .rate[data-rate="monthly"] {
    opacity: 0;
    visibility: hidden;
  }

  .rate-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .was {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-slate-on-ink);
  }

  .amount {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .per,
  .billed {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-slate);
  }

  .billed {
    margin-top: 4px;
  }

  .card--featured .per,
  .card--featured .billed {
    color: var(--color-slate-on-ink);
  }

  .note {
    margin-top: 8px;
    /* Hauteur réservée : les notes font une ou deux lignes selon le plan, et sans
       ce plancher les quatre listes de fonctions ne s'alignent plus. */
    min-height: 36px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-slate);
  }

  .card--featured .note {
    color: var(--color-slate-on-ink);
  }

  .dash {
    margin: 11px 0;
    border-top: 1.5px dashed var(--color-rule);
  }

  .card--featured .dash {
    border-top-color: var(--color-ink-border);
  }

  /* ---- Liste de fonctions ---- */

  .feats {
    display: flex;
    flex-direction: column;
    gap: 7px;
    /* Écart minimal avec le CTA, que `margin-top: auto` pousse en bas de carte. */
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .feat {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    line-height: 1.35;
    /* Les libellés sont calibrés pour ne jamais passer à la ligne à cette largeur
       de colonne — voir PLAN_FEATURES. */
    white-space: nowrap;
  }

  .mark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    /* `live` plein ne porte que 3,46:1 face au blanc du ✓ : c'est la variante
       assombrie qui prend le glyphe (5,53:1), règle posée dans global.css. */
    background: var(--color-live-on-light);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
  }

  .feat--off .mark {
    border: 1.5px solid var(--color-rule);
    background: none;
    color: var(--color-receipt-rule);
  }

  /* Valeur locale du handoff : le seul gris qui se détache de `ink` sans devenir
     un filet clair. `ink-border` disparaîtrait derrière le ✕. */
  .card--featured .feat--off .mark {
    border-color: #3a4560;
    color: #3a4560;
  }

  /* Un cran plus clair que le libellé inclus, jamais sous AA : ce sont de vraies
     informations produit, pas de la décoration. */
  .feat--off .feat-text {
    color: var(--color-slate);
  }

  .card--featured .feat--off .feat-text {
    color: var(--color-slate-on-ink);
  }

  /* ---- CTA ---- */

  .cta {
    display: block;
    margin-top: auto;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: #fff;
    padding: 11px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .cta:hover {
    border-color: var(--color-ink);
  }

  .card--featured .cta {
    border-color: var(--color-hour);
    background: var(--color-hour);
  }

  .card--featured .cta:hover {
    border-color: var(--color-hour-hover);
    background: var(--color-hour-hover);
  }

  /* ---- Mention beta ---- */

  .beta {
    margin-top: 18px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-hour);
  }

  .beta span {
    border: 1px solid var(--color-hour);
    border-radius: 3px;
    padding: 4px 9px;
  }

  /* ---- Le pli d'arrivée ---- */

  /* ⚠️ Jamais la forme raccourcie `animation:` ici. Une déclaration sans nom
     d'animation (`animation: 520ms ease backwards`) est renormalisée en
     `animation: none` par Lightning CSS au build : le nom posé par la règle
     suivante survit, la durée non, et l'animation s'exécute en 0 s — donc
     invisible, sans la moindre erreur nulle part. Longhands uniquement. */
  @media (prefers-reduced-motion: no-preference) {
    .shell,
    .card,
    .ear {
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      animation-fill-mode: backwards;
      /* 90 ms d'écart : la cadence de la pile de l'accueil. Les quatre cartes se
         lisent comme une seule main qui passe, pas comme quatre animations. */
      animation-delay: calc(var(--i, 0) * 90ms);
    }

    /* La carte se pose. `opacity` part de 0.25 et non de 0 : les cartes sont le
       plus gros bloc au-dessus de la ligne de flottaison, et un élément à
       `opacity: 0` est ignoré par la mesure du LCP — il ne compterait comme peint
       qu'à la fin du fondu. À 0.25 il est peint dès la première image.
       `transform` et `opacity` seuls : rien ne bouge dans le flux, CLS intact. */
    .shell {
      animation-name: card-rise;
      animation-duration: 620ms;
    }

    /* Puis le coin se tourne — après que la carte a touché le sol (42 %), avec un
       léger dépassement qui retombe, comme un papier qu'on plie. */
    .card {
      animation-name: card-fold;
      animation-duration: 900ms;
    }

    .ear {
      animation-name: ear-fold;
      animation-duration: 900ms;
    }
  }

  @keyframes card-rise {
    from {
      opacity: 0.25;
      transform: translateY(18px);
    }
  }

  /* L'encoche du `clip-path` et l'échelle du rabat partent du même coin et
     avancent au même rythme : le rabat épouse donc la coupe à chaque image, et
     l'encoche n'est jamais un trou. Les deux séries de pourcentages doivent rester
     identiques, et 1.2 en échelle vaut exactement 36px de coupe (30 × 1.2). */
  @keyframes card-fold {
    0%,
    42% {
      clip-path: polygon(0 0, calc(100% - 0px) 0, 100% 0px, 100% 100%, 0 100%);
    }

    78% {
      clip-path: polygon(
        0 0,
        calc(100% - var(--ear) * 1.2) 0,
        100% calc(var(--ear) * 1.2),
        100% 100%,
        0 100%
      );
    }

    100% {
      clip-path: polygon(0 0, calc(100% - var(--ear)) 0, 100% var(--ear), 100% 100%, 0 100%);
    }
  }

  @keyframes ear-fold {
    0%,
    42% {
      transform: scale(0);
    }

    78% {
      transform: scale(1.2);
    }

    100% {
      transform: scale(1);
    }
  }

  /* ---- Survol : le coin se soulève ---- */

  /* Le handoff écrivait « card hover: none », et `DESIGN.md` interdit qu'un
     élément se déplace au survol. Les deux sont levés sur demande — mais le geste
     reste celui de la carte : c'est la pliure qui s'ouvre, pas un effet posé
     par-dessus. Sous `hover: hover` uniquement : sur tactile, un survol collant
     après un tap laisserait une carte à moitié dépliée. */
  .shell {
    transition:
      transform 0.24s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.24s ease;
  }

  .card {
    transition: clip-path 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ear {
    transition:
      transform 0.24s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.24s ease;
  }

  @media (hover: hover) {
    /* La carte quitte le plan de la page — c'est ce qui autorise l'ombre à
       s'approfondir (« The Off-Plane Rule »), pas une envie de relief. */
    .shell:hover {
      transform: translateY(-4px);
      filter: drop-shadow(0 14px 18px rgb(15 21 36 / 0.16));
    }

    .shell--featured:hover {
      filter: drop-shadow(0 26px 30px rgb(15 21 36 / 0.5));
    }

    .shell:hover .card {
      clip-path: polygon(
        0 0,
        calc(100% - var(--ear) * 1.5) 0,
        100% calc(var(--ear) * 1.5),
        100% 100%,
        0 100%
      );
    }

    .shell:hover .ear {
      transform: scale(1.5);
      box-shadow: -3px 3px 7px rgb(15 21 36 / 0.22);
    }
  }
</style>
