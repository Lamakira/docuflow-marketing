---
import { STAGES } from "../data/site";
---

{/* Rail d'étapes — seul élément décoratif de la page (brief §5).
    Desktop large uniquement : sous 1240px il n'y a pas de gouttière pour l'accueillir. */}
<div class="stage-rail" aria-hidden="true">
  <div class="track">
    <div class="fill" data-rail-fill></div>
    <span class="dot" data-rail-dot></span>
  </div>
  <ul class="ticks">
    {
      STAGES.map((stage, i) => (
        <li style={`top:${(i / (STAGES.length - 1)) * 100}%`}>{stage}</li>
      ))
    }
  </ul>
</div>

<style>
  .stage-rail {
    position: fixed;
    left: 22px;
    top: 20vh;
    height: 60vh;
    z-index: 20;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 1240px) {
    .stage-rail {
      display: block;
    }
  }

  .track {
    position: relative;
    width: 1px;
    height: 100%;
    background: var(--color-rule);
  }

  .fill {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 0%;
    background: var(--color-hour);
  }

  .dot {
    position: absolute;
    left: 50%;
    top: 0%;
    width: 5px;
    height: 5px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--color-hour);
  }

  .ticks {
    position: absolute;
    inset: 0;
    left: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: absolute;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-slate);
    opacity: 0.75;
  }
</style>

<script>
  // Progression écrite directement dans le DOM, throttlée en rAF.
  // Ne jamais router ça par de l'état framework : ça re-rend la page à chaque pixel.
  const fill = document.querySelector<HTMLElement>("[data-rail-fill]");
  const dot = document.querySelector<HTMLElement>("[data-rail-dot]");

  if (fill && dot) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
      fill.style.height = pct + "%";
      dot.style.top = pct + "%";
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
