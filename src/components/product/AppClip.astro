---
/**
 * Un geste filmé dans l'application web v2 : `AppScreen`, en mouvement.
 *
 * Mêmes trois règles qu'`AppScreen.astro` (données fictives, écran non retouché,
 * rendu plat), plus quatre propres au mouvement :
 *
 *  1. **L'image fixe est le contenu, la vidéo l'enjolive.** `poster` est
 *     l'image du clip qui soutient le mieux le texte (la dernière, sauf exception)
 *     et reste affichée sans JS, en mouvement réduit, ou si
 *     la vidéo ne charge pas. La vidéo se pose par-dessus : CLS nul.
 *  2. **Aucun octet de vidéo avant l'écran.** `preload="none"`, source posée par le
 *     script à l'approche, lecture seulement quand le clip est visible.
 *  3. **`prefers-reduced-motion` : pas de lecture du tout.** L'attribut `autoplay`
 *     ignore cette préférence, il est donc interdit ici.
 *  4. **Un bouton Pause** : toute boucle qui dépasse 5 s l'exige (WCAG 2.2.2).
 *
 * Le curseur de la souris n'apparaît pas : le navigateur de capture n'en dessine
 * pas, et en ajouter un serait retoucher l'écran. Choisir des gestes qui se lisent
 * sans lui. Jamais dans un héros : c'est l'élément LCP.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  poster: ImageMetadata;
  alt: string;
}

const { src, poster, alt } = Astro.props;

const widths = [640, 960, poster.width].filter((w, i, all) => w <= poster.width && all.indexOf(w) === i);
---

<figure class="app-clip" data-clip>
  <div class="app-clip-frame">
    <Image
      src={poster}
      alt={alt}
      widths={widths}
      sizes="(max-width: 900px) calc(100vw - 48px), 640px"
      loading="lazy"
      decoding="async"
      class="app-clip-img"
    />
    <video
      class="app-clip-video"
      data-src={src}
      width={poster.width}
      height={poster.height}
      preload="none"
      muted
      loop
      playsinline
      disablepictureinpicture
      aria-hidden="true"
      tabindex="-1"
    ></video>
  </div>
  <figcaption class="app-clip-caption">
    <span>DocuFlow web app · demo workspace</span>
    <button type="button" class="app-clip-toggle" data-clip-toggle>Pause</button>
  </figcaption>
</figure>

<style>
  .app-clip {
    margin: 0;
  }

  .app-clip-frame {
    position: relative;
    overflow: clip;
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: #fff;
  }

  .app-clip-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Vide tant que le script ne lui a pas donné de source : il ne masque rien. */
  .app-clip-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  .app-clip[data-on] .app-clip-video {
    visibility: visible;
  }

  .app-clip-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-slate);
  }

  /* Place réservée en permanence ; sans script, le bouton ne commande rien. */
  .app-clip-toggle {
    min-height: 32px;
    padding: 0 8px;
    margin-right: -8px;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    visibility: hidden;
  }

  .app-clip[data-on] .app-clip-toggle {
    visibility: visible;
  }

  @media (hover: hover) {
    .app-clip-toggle:hover {
      color: var(--color-ink);
    }
  }
</style>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-clip]").forEach((clip) => {
    const video = clip.querySelector("video");
    const toggle = clip.querySelector<HTMLButtonElement>("[data-clip-toggle]");
    if (!video || !toggle) return;

    let inView = false;
    let pausedByReader = false;

    const label = () => {
      toggle.textContent = pausedByReader ? "Play" : "Pause";
      toggle.setAttribute("aria-label", `${toggle.textContent} the animation`);
    };

    const sync = () => {
      if (still.matches) {
        video.pause();
        delete clip.dataset.on;
        return;
      }
      if (inView && !pausedByReader) {
        if (!video.src) video.src = video.dataset.src ?? "";
        // Lecture refusée par le navigateur : l'image fixe reste en place.
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };

    video.addEventListener("playing", () => {
      if (!still.matches) clip.dataset.on = "";
    });

    toggle.addEventListener("click", () => {
      pausedByReader = !pausedByReader;
      label();
      sync();
    });

    still.addEventListener("change", sync);
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        sync();
      },
      { threshold: 0.4 },
    ).observe(clip);
    label();
  });
</script>
