---
import { NAV_LINKS } from "../data/site";
---

<header
  class="sticky top-0 z-30 h-16 border-b border-rule bg-paper/90 backdrop-blur-[8px]"
>
  <nav class="container-page flex h-full items-center justify-between gap-4">
    <div class="flex items-center gap-[26px]">
      <a href="/" class="font-display text-xl font-extrabold tracking-[-0.02em]">DocuFlow</a>

      <ul class="hidden items-center gap-[26px] min-[561px]:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[15px] font-medium text-slate transition-colors hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex items-center gap-4">
      <a href="/signin" class="text-[15px] font-medium text-slate transition-colors hover:text-ink">
        Sign in
      </a>
      <a
        href="/signup"
        class="rounded-[6px] bg-ink px-4 py-[9px] text-[15px] font-medium text-paper transition-colors hover:bg-[#1c2740]"
      >
        Start free trial
      </a>
    </div>
  </nav>
</header>
