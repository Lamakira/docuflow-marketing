---
import { FOOTER_COLUMNS } from "../data/site";
---

{/* Organe de maillage interne autant que pied de page : dense et complet, c'est voulu. */}
<footer class="bg-ink text-slate-on-ink">
  <div class="container-page py-16">
    <div
      class="grid grid-cols-1 gap-10 min-[561px]:grid-cols-2 min-[901px]:grid-cols-[1.4fr_repeat(4,1fr)]"
    >
      <div>
        <p class="font-display text-xl font-extrabold text-white">DocuFlow</p>
        <p class="mt-3 max-w-[34ch] text-[14px] leading-relaxed">
          Clients, projects, hours and documentation in one tool. Built and run by TECHMA.
        </p>
      </div>

      {
        FOOTER_COLUMNS.map((column) => (
          <div>
            <p class="label-mono text-[11px] text-slate-on-ink/70">{column.title}</p>
            <ul class="mt-4 space-y-[10px]">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[14px] transition-colors hover:text-paper">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-ink-border pt-6 font-mono text-[12px] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © 2026 TECHMA · <a href="/legal/terms" class="hover:text-paper">Terms</a> ·
        <a href="/legal/privacy" class="hover:text-paper">Privacy</a> ·
        <a href="/legal/law-25" class="hover:text-paper">Law 25</a>
      </p>

      <label class="flex items-center gap-2">
        <span class="sr-only">Language</span>
        <select
          class="rounded-[3px] border border-ink-border bg-ink-raised px-2 py-1 font-mono text-[12px] text-slate-on-ink"
        >
          <option>English</option>
          <option>Français</option>
        </select>
      </label>
    </div>
  </div>
</footer>
