---
import PillarSection from "../PillarSection.astro";
import AppScreen from "../product/AppScreen.astro";
import ledgerDocumentation from "../../assets/screens/ledger-documentation.png";

interface Props {
  /** Posé par `index.astro` d'après le rang du pilier — jamais en dur ici. */
  reverse?: boolean;
}

const { reverse = false } = Astro.props;
---

<PillarSection
  stage="IN PROGRESS"
  note="the documentation"
  heading="Write it where the work is."
  body="The block editor lives inside the client project - specs, meeting notes, statements of work, nested pages, reusable templates. Not a separate wiki nobody opens, because it's already where the work is."
  band="bg-band-warm"
  reverse={reverse}
>
  {/* La vraie documentation de projet (23 novembre 2026) : l'onglet Documentation de la fiche projet, l'arbre de pages et l'éditeur de blocs. Un autre projet que la capture de `/product`, pour ne pas montrer deux fois le même écran. */}
  <AppScreen src={ledgerDocumentation} alt="DocuFlow project documentation inside the Ledger migration client project: the Documentation tab, the page tree and the block editor with its toolbar." />
</PillarSection>
