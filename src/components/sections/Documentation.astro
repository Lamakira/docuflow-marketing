---
import PillarSection from "../PillarSection.astro";
import AppClip from "../product/AppClip.astro";
import poster from "../../assets/clips/nested-page.png";
import clip from "../../assets/clips/nested-page.mp4";

interface Props {
  /** Posé par `index.astro` d'après le rang du pilier — jamais en dur ici. */
  reverse?: boolean;
}

const { reverse = false } = Astro.props;
---

<PillarSection
  stage="IN PROGRESS"
  note="the documentation"
  heading="Write it where the work is."
  body="The block editor lives inside the client project - specs, meeting notes, statements of work, nested pages, reusable templates. Not a separate wiki nobody opens, because it's already where the work is."
  band="bg-band-warm"
  reverse={reverse}
>
  {/* Ouvrir une page imbriquée : un geste filmé, règles dans `product/AppClip.astro`. */}
  <AppClip src={clip} poster={poster} alt="DocuFlow project documentation: the Technical spec page is expanded and its nested Rollback plan page is open in the block editor." />
</PillarSection>
