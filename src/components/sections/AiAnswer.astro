---
import { ANSWER_CARD } from "../../data/site";
import PillarSection from "../PillarSection.astro";

interface Props {
  /** Posé par `index.astro` d'après le rang du pilier — jamais en dur ici. */
  reverse?: boolean;
}

const { reverse = false } = Astro.props;
---

<PillarSection
  stage="IN REVIEW"
  note="the answer"
  heading="Ask your own company a question."
  body="Documentation, company files and meeting recordings are indexed as they're written. Ask “what did we agree on the Ledger rebuild?” and get the answer with its source, not a list of files."
  reverse={reverse}
>
  {/* Question, réponse et sources : source unique dans `data/site.ts`
      (`ANSWER_CARD`), partagée avec la maquette `/product` (`AnswerMock.astro`). */}
  <div class="rounded-[8px] border border-rule bg-white p-5">
    <p class="rounded-[6px] bg-paper px-3 py-2 font-mono text-[13px]">
      {ANSWER_CARD.question}
    </p>

    <p class="mt-4 text-[15px] leading-[1.6]">
      {ANSWER_CARD.answer}
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      {
        ANSWER_CARD.sources.map((source) => (
          <span class="rounded-[3px] border border-live-on-light px-2 py-[3px] font-mono text-[11px] text-live-on-light">
            {source}
          </span>
        ))
      }
    </div>
  </div>
</PillarSection>
