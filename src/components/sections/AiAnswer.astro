---
import PillarSection from "../PillarSection.astro";
---

<PillarSection
  stage="IN REVIEW"
  note="the answer"
  heading="Ask your own company a question."
  body="Documentation, company files and meeting recordings are indexed as they're written. Ask “what did we agree on the Ledger rebuild?” and get the answer with its source, not a list of files."
>
  <div class="rounded-[8px] border border-rule bg-white p-5">
    <p class="rounded-[6px] bg-paper px-3 py-2 font-mono text-[13px]">
      what did we agree on the Ledger rebuild?
    </p>

    <p class="mt-4 text-[15px] leading-[1.6]">
      Fixed scope: migration only, no new reporting. Northwind signed off on a two-sprint window at
      the April 3 call.
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      <span class="rounded-[3px] border border-live px-2 py-[3px] font-mono text-[11px] text-live">
        doc · Ledger SOW
      </span>
      <span class="rounded-[3px] border border-live px-2 py-[3px] font-mono text-[11px] text-live">
        call · Apr 3
      </span>
    </div>
  </div>
</PillarSection>
