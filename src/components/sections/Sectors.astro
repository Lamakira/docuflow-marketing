---
import SectorEntry from "../SectorEntry.astro";
import { SECTORS } from "../../data/site";
---

<section id="solutions" class="container-wide py-[88px]">
  <p class="mb-6 font-mono text-[13px]">
    <span class="text-hour">COMPLETED</span>{" "}
    <span class="text-slate">- who it's for</span>
  </p>

  <h2 class="max-w-[16ch] text-[clamp(28px,4vw,42px)]">Teams that deliver for clients.</h2>

  {/* Un index, pas une grille de cartes : plus de boîtes blanches, des filets
      1 px et des numéros. Une vraie liste — le lecteur d'écran annonce « liste,
      8 éléments », ce qu'une suite de liens ne dit pas.

      Le filet est en haut de CHAQUE entrée, première rangée comprise : c'est ce
      qui fait lire un registre réglé plutôt que huit blocs séparés.

      L'entrée elle-même vit dans `components/SectorEntry.astro` depuis le
      27 juillet 2026 : `/solutions` rend le même registre, et deux exemplaires
      du dessin auraient divergé au premier réglage. */}
  <ul class="mt-12 grid grid-cols-1 gap-x-[72px] gap-y-0 min-[901px]:grid-cols-2">
    {
      SECTORS.map((sector, i) => (
        <li>
          <SectorEntry sector={sector} index={i} />
        </li>
      ))
    }
  </ul>
</section>
