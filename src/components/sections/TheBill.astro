---
import { STACK, STACK_TOTAL, DOCUFLOW_PRICE, PLANS } from "../../data/site";
---

<section id="pricing" class="bg-ink py-[92px] text-slate-on-ink">
  <div class="container-page">
    <p class="mb-6 font-mono text-[13px] text-hour">COMPLETED — the bill</p>

    <div class="grid items-start gap-14 min-[901px]:grid-cols-2">
      <h2 class="text-[clamp(34px,5vw,56px)] text-white">Four tools.<br />One bill.</h2>

      {/* Le reçu reprend l'ordre des cartes de l'animation — les deux listes
          doivent rester synchronisées (source unique : src/data/site.ts). */}
      <div class="rounded-[8px] border border-ink-border bg-ink-raised p-6 font-mono text-[14px]">
        {
          STACK.map((item) => (
            <div class="flex justify-between py-[6px]">
              <span>{item.name}</span>
              <span>${String(item.price).padStart(2, " ")} /user/mo</span>
            </div>
          ))
        }

        <div class="mt-3 border-t border-ink-border pt-3">
          <div class="flex justify-between py-[6px] font-medium text-white">
            <span>Your stack</span>
            <span>${STACK_TOTAL} /user/mo</span>
          </div>
          <div class="flex justify-between py-[6px] font-bold text-hour">
            <span>DocuFlow</span>
            <span>${DOCUFLOW_PRICE} /user/mo</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
      <span class="rounded-[3px] border border-hour px-3 py-[5px] font-mono text-[12px] text-hour">
        Beta pricing — subject to change
      </span>
      <a href="/pricing" class="text-[15px] transition-colors hover:text-paper">
        Compare all plans →
      </a>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 min-[561px]:grid-cols-2 min-[901px]:grid-cols-4">
      {
        PLANS.map((plan) => (
          <article
            class={`rounded-[8px] p-6 ${
              plan.featured
                ? "border-2 border-hour bg-paper text-ink"
                : "border border-ink-border bg-ink-raised"
            }`}
          >
            <p class={`font-semibold ${plan.featured ? "text-ink" : "text-white"}`}>{plan.name}</p>
            <p
              class={`mt-2 font-mono text-[34px] font-bold ${plan.featured ? "text-ink" : "text-white"}`}
            >
              {plan.price}
            </p>
            <p class={`mt-3 text-[13px] leading-snug ${plan.featured ? "text-slate" : ""}`}>
              {plan.note}
            </p>
            <a
              href="/signup"
              class={`mt-6 block rounded-[6px] py-[9px] text-center text-[14px] font-medium transition-colors ${
                plan.featured
                  ? "bg-hour text-ink hover:bg-hour-hover"
                  : "border border-ink-border text-white hover:border-slate-on-ink"
              }`}
            >
              {plan.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
