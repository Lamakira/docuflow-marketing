---
import { APP_SIGN_UP } from "../../data/app";

interface Props {
  /** Chaque page appelle à l'action avec ses mots. Le défaut est celui de
   *  l'accueil — la copy vient du handoff validé, ne pas l'improviser ici. */
  title?: string;
  /** Ligne mono sous les boutons. Absente sur l'accueil, présente sur `/pricing`. */
  note?: string;
}

const { title = "Start with your next client project.", note } = Astro.props;
---

{/* `container-page` et non `container-wide` : le débord droit rend le conteneur
    asymétrique, donc son milieu tombe ~90px à droite du milieu de la page. Pour du
    contenu aligné à gauche c'est le but ; pour un bloc centré, ça se voit comme un
    défaut. Le bord gauche est le même dans les deux conteneurs — cette bande reste
    donc alignée avec le reste de la page. */}
<section class="bg-hour py-[92px] text-center">
  <div class="container-page">
    <h2 class="mx-auto max-w-[20ch] text-[clamp(30px,4.5vw,48px)] text-ink">
      {title}
    </h2>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={APP_SIGN_UP}
        class="rounded-[6px] bg-ink px-[22px] py-[13px] font-medium text-paper transition-colors hover:bg-[#1c2740]"
      >
        Start free trial
      </a>
      {/* Rangée d'un seul bouton : « Book a 15-minute demo » visait `/demo`, page
          inexistante, et est retiré (#231 — voir AGENTS.md). Les classes de
          rangée restent : le rétablir ne doit pas demander de les retrouver. */}
    </div>

    {note && <p class="mt-5 font-mono text-[12.5px] text-ink/75">{note}</p>}
  </div>
</section>
