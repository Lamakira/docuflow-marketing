---
import PillarSection from "../PillarSection.astro";

/** Niveaux d'activité sur la session : > 70 % live, > 40 % hour, sinon rule. */
const activity = [
  52, 78, 84, 61, 47, 73, 91, 12, 58, 66, 44, 55, 81, 88, 39, 72, 95, 63, 49, 77, 85, 31, 68, 74,
  57, 42,
];

const tone = (value: number) =>
  value > 70 ? "var(--color-live)" : value > 40 ? "var(--color-hour)" : "var(--color-rule)";
---

<PillarSection
  stage="IN PROGRESS"
  note="the hours"
  heading="What happened, not what was reported."
  body="The desktop agent records screenshots, keyboard and mouse activity and idle time in the background, and files everything against the project the timer was running on. Nobody writes a timesheet from memory."
  band="bg-band-mint"
  stageTone="live"
>
  <div class="rounded-[8px] border border-rule bg-white p-5">
    <div class="flex items-baseline justify-between">
      <p class="font-mono text-[12px] text-slate">Northwind · Ledger rebuild</p>
      <p class="font-mono text-[12px] font-bold text-live">88% active</p>
    </div>

    <div class="mt-4 grid grid-cols-4 gap-3">
      {
        Array.from({ length: 4 }).map(() => (
          <span
            class="block aspect-[4/3] rounded-[3px] border border-rule"
            style="background:repeating-linear-gradient(45deg,#F3F5F7 0 4px,#fff 4px 8px)"
          />
        ))
      }
    </div>

    <div class="mt-5 flex h-10 items-end gap-[3px]" aria-hidden="true">
      {
        activity.map((value) => (
          <span
            class="flex-1 rounded-[1px]"
            style={`height:${value}%;background:${tone(value)}`}
          />
        ))
      }
    </div>
    <p class="mt-2 font-mono text-[10px] text-slate">Activity level · last 26 intervals</p>
  </div>
</PillarSection>
