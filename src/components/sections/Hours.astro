---
import PillarSection from "../PillarSection.astro";
import AppClip from "../product/AppClip.astro";
import poster from "../../assets/clips/hours-to-project.png";
import clip from "../../assets/clips/hours-to-project.mp4";

interface Props {
  /** Posé par `index.astro` d'après le rang du pilier — jamais en dur ici. */
  reverse?: boolean;
}

const { reverse = false } = Astro.props;
---

<PillarSection
  stage="IN PROGRESS"
  note="the hours"
  heading="What happened, not what was reported."
  body="The desktop agent records screenshots, keyboard and mouse activity and idle time in the background, and files everything against the project the timer was running on. Nobody writes a timesheet from memory."
  reverse={reverse}
>
  <AppClip src={clip} poster={poster} alt="DocuFlow project record, Time tab: a timer has just started and its running entry is first in the list, above the stopped entries of the Ledger rebuild project." />
</PillarSection>
