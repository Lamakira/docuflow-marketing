---
import PillarSection from "../PillarSection.astro";
import AppClip from "../product/AppClip.astro";
import poster from "../../assets/clips/client-to-project.png";
import clip from "../../assets/clips/client-to-project.mp4";

interface Props {
  /** Posé par `index.astro` d'après le rang du pilier — jamais en dur ici. */
  reverse?: boolean;
}

const { reverse = false } = Astro.props;
---

<PillarSection
  stage="WON"
  note="the client"
  heading="The client record everything hangs off."
  body="Companies, contacts, budgets, stages and notes live in the CRM. Every project, task, hour, screenshot and document files itself against the right client - not because someone tagged it, but because that's where it was created."
  band="bg-band-mint"
  stageTone="live"
  reverse={reverse}
>
  {/* De la fiche client au projet qui lui est rattaché : un geste filmé, règles dans `product/AppClip.astro`. */}
  <AppClip src={clip} poster={poster} alt="DocuFlow client record for Northwind Systems: client details, contacts and the client's projects. The animation opens the Ledger rebuild project." />
</PillarSection>
