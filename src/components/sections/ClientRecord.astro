---
import PillarSection from "../PillarSection.astro";

interface Props {
  /** Posé par `index.astro` d'après le rang du pilier — jamais en dur ici. */
  reverse?: boolean;
}

const { reverse = false } = Astro.props;

const contacts = [
  { initials: "EP", name: "Elena Park", role: "VP Finance" },
  { initials: "RA", name: "Rob Adeyemi", role: "Controller" },
  { initials: "SD", name: "Sofia Duarte", role: "Project sponsor" },
];

/** Mêmes personnes que la carte du héros — les deux listes doivent rester
 *  identiques. Neutres : un avatar vert ferait dire « confirmé » à un contact. */
const AVATAR_TONES = ["#0F1524", "#2A3348", "#59657A"];
---

<PillarSection
  stage="WON"
  note="the client"
  heading="The client record everything hangs off."
  body="Companies, contacts, budgets, stages and notes live in the CRM. Every project, task, hour, screenshot and document files itself against the right client - not because someone tagged it, but because that's where it was created."
  band="bg-band-mint"
  stageTone="live"
  reverse={reverse}
>
  {/* La fiche client elle-même. Les heures n'y sont qu'une ligne parmi d'autres —
      c'est délibéré : le mandat est le sujet, pas le chronomètre. */}
  <div class="rounded-[8px] border border-rule bg-white p-5">
    <div class="flex items-center justify-between gap-3">
      <p class="font-display text-[17px] font-bold">Northwind Systems</p>
      <span class="rounded-[3px] bg-hour px-2 py-[3px] font-mono text-[10px] font-bold text-ink">
        Won - In progress
      </span>
    </div>

    <ul class="mt-4 space-y-2 border-t border-rule pt-4">
      {
        contacts.map((contact, i) => (
          <li class="flex items-center gap-3">
            <span
              class="grid h-6 w-6 place-items-center rounded-full font-mono text-[9px] text-white"
              style={`background:${AVATAR_TONES[i]}`}
            >
              {contact.initials}
            </span>
            <span class="text-[14px] font-medium">{contact.name}</span>
            <span class="font-mono text-[11px] text-slate">{contact.role}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 border-t border-rule pt-4">
      <div class="flex items-baseline justify-between">
        <span class="font-mono text-[11px] text-slate">Budget</span>
        <span class="font-mono text-[15px] font-bold">$48,000</span>
      </div>
      {/* La jauge et son relevé énoncent la même chose : même vert. Le relevé étant
          du texte, c'est la variante lisible qui gagne, et la barre la suit — deux
          verts à 8 px l'un de l'autre se liraient comme une erreur. */}
      <span class="mt-2 block h-[6px] overflow-hidden rounded-full bg-paper">
        <span class="block h-full w-[62%] bg-live-on-light"></span>
      </span>
      <p class="mt-1 text-right font-mono text-[11px] text-live-on-light">62% used</p>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-rule pt-4">
      <span class="rounded-[3px] border border-rule px-2 py-[2px] font-mono text-[10px] text-slate">
        retainer
      </span>
      <span class="rounded-[3px] border border-rule px-2 py-[2px] font-mono text-[10px] text-slate">
        Q2
      </span>
      <span class="ml-auto font-mono text-[11px] text-slate">Apr 12 · Scope review</span>
    </div>

    <p class="mt-4 border-t border-rule pt-3 font-mono text-[11px] text-slate">
      71.7 h logged · 4 documents · 12 tasks
    </p>
  </div>
</PillarSection>
