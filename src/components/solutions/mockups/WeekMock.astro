---
import CaptureThumb from "../../CaptureThumb.astro";
import { CAPTURE_VARIANTS } from "../../captures";
import { evidenceRows, evidenceScore, minutesOf } from "../../../data/solutions";
/** La semaine enregistrée, jour par jour — le relevé qu'on peut compter.
 *
 * ─── Pourquoi elle remplace `ScoreMock` sur le héros ───────────────────────
 *
 * `ScoreMock` posait `84/100` au-dessus de huit vignettes identiques et de
 * vingt-quatre fenêtres d'activité anonymes. Reproche reçu, et fondé : ça ne
 * ressemble pas au relevé DE JOURNÉES, ça ressemble à une texture. Un
 * histogramme sans axe ne se compte pas et ne se reconnaît pas — or le lecteur
 * de cette page est un opérateur méfiant à qui on a déjà vendu des tableaux de
 * bord, et le H1 lui promet précisément quelque chose à LIRE :
 * « You cannot see the work. You can read the record. »
 *
 * Un relevé se lit s'il a des jours, des heures et un total. Les trois sont là,
 * et le total se déduit des journées plutôt que de s'écrire à côté d'elles.
 *
 * ─── Pourquoi elle ne double pas `SilenceMock` ─────────────────────────────
 *
 * Les deux parlent d'une semaine, et c'est voulu — le scénario montre CETTE
 * semaine-là cassée. Mais la forme diffère, et c'est ce qui les sépare à l'oeil :
 *
 *   héros     rangées — un registre de cinq journées, chacune avec son compte
 *   scénario  une frise — une ligne de temps qui s'interrompt
 *
 * Le registre se compte, la frise se parcourt. Voir la semaine entière ici rend
 * la coupure du scénario lisible : le lecteur sait à quoi elle ressemblait
 * avant.
 *
 * ⚠️ Le total est DÉRIVÉ (`38 h`) et tombe sur le chiffre du scénario — « one
 * person's week reads 11 h against 38 h the week before ». Trois endroits, une
 * seule vérité. Changer une journée change le total ; retaper le total à côté
 * de journées qui ne l'atteignent pas est exactement la faute que ce calcul
 * rend impossible.
 *
 * ⚠️ Le SCORE aussi est dérivé (23 novembre 2026). Le temps suivi, les
 * captures et l'activité moyenne viennent des journées ; les doublons et le
 * dernier contact du poste sont passés à part ; `evidenceScore()` applique la
 * formule du produit. Les anciennes semaines portaient 2 ou 3 captures par
 * jour sous un « 84 » : 13 captures pour 38 h plafonnent le score vers 62, et
 * l'agent en prend en réalité une toutes les 3 à 5 minutes par défaut. Les
 * vignettes sont donc un ÉCHANTILLON, et le compte est écrit en chiffres.
 */
interface Props {
  label: string;
  /** `hours` en `H:MM`, `activity` en %, `shots` = captures de la journée. */
  days: { day: string; hours: string; activity: number; shots: number }[];
  /** Part de captures en double sur la semaine, en %. */
  duplicates: number;
  /** Jours depuis le dernier contact du poste. 0 = aujourd'hui. */
  seenDaysAgo: number;
  foot: string;
  /** Traitement Layered Paper — voir `DESIGN.md`, « Layered Paper Card ». */
  warm?: boolean;
  /** Bande sombre : seule l'ombre change, la feuille reste claire. */
  onDark?: boolean;
}

const { label, days, duplicates, seenDaysAgo, foot, warm = false, onDark = false } =
  Astro.props;

/** `minutesOf` lève sur une durée hors format : un total muet dans une maquette
 *  de relevé est pire qu'un build cassé. */
const totalMinutes = days.reduce((sum, entry) => sum + minutesOf(entry.hours), 0);
const hours = Math.floor(totalMinutes / 60);
const minutes = totalMinutes % 60;
const tracked = `${hours}:${String(minutes).padStart(2, "0")}`;
/** `38 h` quand la semaine tombe juste, `37:45` sinon — jamais « 37.75 h ». */
const total = minutes === 0 ? `${hours} h` : tracked;

/** Les entrées du score, toutes dérivées des journées sauf deux. L'activité
 *  moyenne est pondérée par les heures : une journée de deux heures ne pèse
 *  pas autant qu'une de huit. */
const screenshots = days.reduce((sum, entry) => sum + entry.shots, 0);
const activity = Math.round(
  days.reduce((sum, entry) => sum + minutesOf(entry.hours) * entry.activity, 0) / totalMinutes
);
const evidence = { tracked, screenshots, duplicates, activity, events: screenshots > 0, seenDaysAgo };
const { score, grade } = evidenceScore(evidence);
/** « Tracked » est déjà le total du pied : pas deux fois. */
const graded = evidenceRows(evidence).filter((row) => row.label !== "Tracked");

/** Le seuil de `ScoreMock`, repris tel quel : seul STRONG est confirmé. */
const confirmed = grade === "STRONG";

/** Vignettes d'échantillon par journée. Le compte réel est écrit à côté. */
const SAMPLE = 3;

---

<div
  class:list={[
    "week-mock rounded-[8px] border border-rule bg-white p-[18px]",
    { "week-mock--warm": warm, "week-mock--dark": warm && onDark },
  ]}
>
  <div
    class:list={[
      "score-panel flex items-start justify-between gap-4 rounded-[6px] border px-4 py-[14px]",
      confirmed ? "border-live-on-light bg-band-mint" : "score-panel--weak border-rule bg-paper",
    ]}
  >
    <div>
      <p
        class:list={[
          "score-label label-mono text-[10px]",
          confirmed ? "text-live-on-light" : "text-slate",
        ]}
      >
        {label}
      </p>
      <p class="mt-[6px] font-mono text-[36px] font-bold leading-none tracking-[-0.02em]">
        {score}<span class="score-total font-mono text-[14px] font-medium text-slate">/100</span>
      </p>
    </div>

    <span
      class:list={[
        "score-grade shrink-0 rounded-[3px] px-[10px] py-[5px] font-mono text-[11px] font-bold",
        confirmed ? "bg-live-on-light text-white" : "bg-hour text-ink",
      ]}
    >
      {grade}
    </span>
  </div>

  {/* Le registre. Une rangée par journée : c'est ce qui manquait — des jours
      qu'on peut nommer et des heures qu'on peut additionner. */}
  <ul class="days">
    {
      days.map((entry, index) => (
        <li class="day" data-use-case-motion-row>
          <span class="day-name">{entry.day}</span>
          <span class="day-hours">{entry.hours}</span>

          <span class="day-activity" aria-hidden="true">
            <span class="day-fill" style={`width:${entry.activity}%`} />
          </span>

          {/* Les captures de la journée : un échantillon de vignettes et le
              compte en chiffres. Un compte se vérifie ; cent vignettes en
              rangée ne se lisent plus. */}
          <span class="day-shots">
            {Array.from({ length: Math.min(SAMPLE, entry.shots) }).map((_, n) => (
              <span class="shot" aria-hidden="true">
                <CaptureThumb variant={CAPTURE_VARIANTS[(index + n) % CAPTURE_VARIANTS.length]} size="sm" />
              </span>
            ))}
            <span class="shot-count">{entry.shots}</span>
          </span>
        </li>
      ))
    }
  </ul>

  {/* Ce que le score a noté : les entrées de la formule, en clair. */}
  <dl class="graded">
    {
      graded.map((row) => (
        <div class="graded-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>

  <footer class="week-foot">
    <span class="week-total">{total}</span>
    <span class="week-note">{foot}</span>
  </footer>
</div>

<style>
  .week-mock--warm {
    border: 0;
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
  }

  .week-mock--dark {
    box-shadow: var(--shadow-paper-card-dark);
  }

  .week-mock--warm .score-panel {
    border: 0;
    border-radius: var(--radius-paper-inset);
    background: var(--color-paper-sage);
    box-shadow: var(--shadow-paper-inset);
  }

  .week-mock--warm .score-label {
    color: var(--color-paper-sage-text);
  }

  .week-mock--warm .score-grade {
    background: var(--color-paper-sage-text);
  }

  .week-mock--warm .score-panel--weak {
    background: var(--color-paper-chip);
  }

  .week-mock--warm .score-panel--weak .score-label,
  .week-mock--warm .score-total,
  .week-mock--warm .week-note {
    color: var(--color-paper-label);
  }

  .days {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .day {
    display: grid;
    grid-template-columns: 34px 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--color-rule);
    padding: 9px 2px;
  }

  .week-mock--warm .day {
    border-top-color: var(--color-paper-rule);
  }

  .day-name {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.07em;
    color: var(--color-slate);
  }

  .week-mock--warm .day-name {
    color: var(--color-paper-label);
  }

  .day-hours {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* Plafonnée, et fine. Pleine largeur et à 6px, cinq de ces jauges se lisent
     comme des barres de progression — « ça charge » plutôt que « voilà la
     journée ». Le plafond laisse aussi respirer la rangée entre l'activité et
     les captures. */
  .day-activity {
    display: block;
    height: 5px;
    min-width: 0;
    max-width: 150px;
    border-radius: 999px;
    background: var(--color-rule);
  }

  .week-mock--warm .day-activity {
    background: var(--color-paper-track);
  }

  .day-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--color-live);
  }

  .day-shots {
    display: flex;
    flex: none;
    align-items: center;
    gap: 3px;
  }

  .shot-count {
    min-width: 26px;
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .week-mock--warm .shot-count {
    color: var(--color-paper-label);
  }

  .graded {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 16px;
    margin: 2px 0 0;
    border-top: 1px solid var(--color-rule);
    padding: 10px 2px 8px;
  }

  .week-mock--warm .graded {
    border-top-color: var(--color-paper-rule);
  }

  .graded-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .graded-row dt {
    color: var(--color-slate);
  }

  .week-mock--warm .graded-row dt {
    color: var(--color-paper-label);
  }

  .graded-row dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .shot {
    height: 14px;
    width: 18px;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .week-mock--warm .shot {
    border-color: var(--color-paper-rule);
    --cap-surface: var(--color-paper-surface);
    --cap-chrome: var(--color-paper-chip);
    --cap-mark: var(--color-paper-layer-light);
  }

  .week-foot {
    display: flex;
    align-items: baseline;
    gap: 10px;
    border-top: 1px solid var(--color-rule);
    margin-top: 2px;
    padding-top: 12px;
  }

  .week-mock--warm .week-foot {
    border-top-color: var(--color-paper-rule);
  }

  /* Le total est un relevé du système, donc mono, et il est la seule chose de
     ce pied qui compte : c'est lui qui prouve que les cinq journées font bien
     une semaine. */
  .week-total {
    flex: none;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .week-note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }

  /* Sous 560px les vignettes partent, le compte reste : c'est une entrée du
     score, l'échantillon n'est qu'une illustration. */
  @media (max-width: 560px) {
    .day {
      grid-template-columns: 30px 44px minmax(0, 1fr) auto;
      gap: 8px;
    }

    .shot {
      display: none;
    }

    .graded {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
