---
/** La journée coupée en deux qui se recolle — deux lieux, une feuille.
 *
 * ─── Ce que la section demande ─────────────────────────────────────────────
 *
 * « How one split day reconciles. » Le pilier d'à côté l'énonce : « Events
 * queue locally when the connection drops and reconcile on reconnect WITHOUT
 * DOUBLE COUNTING. »
 *
 * L'objection tient donc dans une addition, et un dessin qui ne s'additionne
 * pas ne la lève pas. Les blocs portent leurs heures, le total est DÉRIVÉ, et
 * c'est le total qui prouve à l'oeil que rien n'a été compté deux fois. Un
 * total retapé à côté de blocs qui ne l'atteignent pas dirait exactement le
 * contraire de la section.
 *
 * ─── Pourquoi ce n'est pas `silence` ───────────────────────────────────────
 *
 * Les deux dessinent un trou dans un relevé, et c'est précisément pour ça
 * qu'ils doivent différer. `remote-teams` dit « le trou s'annonce et ne se
 * referme pas » ; ici le trou SE REFERME. Le même dessin sur les deux pages
 * mentirait sur l'une des deux — et donnerait au lecteur qui les visite toutes
 * les deux la sensation d'avoir déjà lu la page, ce que
 * `docs/mockup-corrections.md` interdit.
 *
 * Là-bas : une frise, une coupure, une pile jamais reprise.
 * Ici : des blocs empilés, une reconnexion nommée, et les blocs en file qui
 * rejoignent la feuille.
 *
 * ⚠️ Les blocs hors ligne ne sont pas grisés comme des absences. Ils sont
 * PRÉSENTS et marqués « queued » : leur contenu a toujours existé, il n'était
 * simplement pas encore arrivé. Les peindre en vide serait redire `silence`.
 */
interface Props {
  label: string;
  blocks: { at: string; place: string; task: string; hours: string; offline?: boolean }[];
  reconnected: string;
  foot: string;
  /** Traitement Layered Paper — voir `DESIGN.md`, « Layered Paper Card ». */
  warm?: boolean;
  /** Bande sombre : seule l'ombre change, la feuille reste claire. */
  onDark?: boolean;
}

const { label, blocks, reconnected, foot, warm = false, onDark = false } = Astro.props;

/** `H:MM` → minutes. Lève plutôt que de rendre `NaN` : un total muet dans une
 *  maquette dont l'argument EST l'addition est pire qu'un build cassé. */
const toMinutes = (value: string) => {
  const match = /^(\d+):([0-5]\d)$/.exec(value);
  if (!match) {
    throw new Error(
      `[solutions] ReconcileMock : durée « ${value} » illisible, format attendu \`H:MM\`. ` +
        `Le total de la journée en est dérivé, et c'est lui qui prouve l'absence de double comptage.`
    );
  }
  return Number(match[1]) * 60 + Number(match[2]);
};

const totalMinutes = blocks.reduce((sum, block) => sum + toMinutes(block.hours), 0);
const hours = Math.floor(totalMinutes / 60);
const minutes = totalMinutes % 60;
const total = minutes === 0 ? `${hours} h` : `${hours}:${String(minutes).padStart(2, "0")}`;

const queued = blocks.filter((block) => block.offline).length;

if (!blocks.some((block) => block.offline)) {
  throw new Error(
    `[solutions] ReconcileMock : aucun bloc \`offline\`. ` +
      `Sans bloc mis en file, il n'y a rien à reconcilier et la carte ne montre qu'une journée ordinaire.`
  );
}
---

<div
  class:list={[
    "reconcile-mock rounded-[8px] border border-rule bg-white p-[18px]",
    { "reconcile-mock--warm": warm, "reconcile-mock--dark": warm && onDark },
  ]}
>
  <header class="head">
    <p class="label label-mono text-[10px] text-slate">{label}</p>
    <span class="queued-chip">{queued} queued</span>
  </header>

  <ol class="blocks">
    {
      blocks.map((block) => (
        <li
          class:list={["block", { "block--offline": block.offline }]}
          data-use-case-motion-row
        >
          <span class="at">{block.at}</span>
          <span class="place">{block.place}</span>
          <span class="task">{block.task}</span>
          <span class="hours">{block.hours}</span>
          {block.offline && <span class="queued-note">queued locally</span>}
        </li>
      ))
    }
  </ol>

  {/* La reconnexion, nommée. C'est la charnière du dessin : au-dessus les blocs
      étaient en file, en dessous ils sont au dossier. */}
  <p class="reconnect">
    <span class="reconnect-dot" aria-hidden="true"></span>
    Reconnected {reconnected} · {queued} {queued === 1 ? "block" : "blocks"} merged, none duplicated
  </p>

  {/* Le total. C'est LUI l'argument : si l'addition tombe juste, rien n'a été
      compté deux fois. Il est dérivé, donc il ne peut pas flatter le dessin. */}
  <footer class="foot">
    <span class="total">{total}</span>
    <span class="note">{foot}</span>
  </footer>
</div>

<style>
  .reconcile-mock--warm {
    border: 0;
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
  }

  .reconcile-mock--dark {
    box-shadow: var(--shadow-paper-card-dark);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .reconcile-mock--warm .label,
  .reconcile-mock--warm .note,
  .reconcile-mock--warm .at,
  .reconcile-mock--warm .place {
    color: var(--color-paper-label);
  }

  .queued-chip {
    border-radius: 3px;
    background: var(--color-paper);
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--color-slate);
  }

  .reconcile-mock--warm .queued-chip {
    background: var(--color-paper-chip);
    color: var(--color-paper-label);
  }

  .blocks {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .block {
    display: grid;
    grid-template-columns: 44px 54px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 10px;
    border-top: 1px solid var(--color-rule);
    padding: 10px 2px;
  }

  .reconcile-mock--warm .block {
    border-top-color: var(--color-paper-rule);
  }

  /* ⚠️ Un bloc hors ligne est PRÉSENT, pas vide. Il porte son heure et sa
     tâche comme les autres. Le peindre en creux dirait « rien ici »,
     c'est-à-dire l'histoire de `SilenceMock`, alors que celle-ci dit « c'était
     là, ça n'était juste pas encore parti ».
     Il se distingue donc par une TEINTE — `paper-chip`, que la palette réserve
     aux capsules de métadonnée discrète — et par sa mention.
     ⚠️ Pas de filet latéral épais : la première version portait un liseré
     gauche de 2px. `DESIGN.md` en autorise un (les chiffres de la bande de
     preuve), donc ce n'était pas interdit — mais c'est un signal faible pour
     « retenu », et c'est le tic de carte générique que cette revue passe son
     temps à retirer. La teinte dit la même chose sans le tic. */
  .block--offline {
    border-top-color: transparent;
    border-radius: var(--radius-paper-inset);
    background: var(--color-paper);
    padding-inline: 10px;
  }

  .reconcile-mock--warm .block--offline {
    background: var(--color-paper-chip);
  }

  .at,
  .place {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-slate);
    font-variant-numeric: tabular-nums;
  }

  .place {
    letter-spacing: 0.06em;
  }

  .task {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hours {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .queued-note {
    grid-column: 3 / -1;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.04em;
    /* ⚠️ Jamais `paper-connector` en TEXTE : c'est une couleur de TRACÉ
       (« lineage paths », DESIGN.md), et elle tombe à 2,6:1 sur papier.
       Relevé par la passe polish du 30 juillet 2026. */
    color: var(--color-paper-label);
  }

  .reconnect {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 12px 0 0;
    border-top: 1px dashed var(--color-rule);
    padding-top: 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-live-on-light);
  }

  .reconcile-mock--warm .reconnect {
    border-top-color: var(--color-paper-rule);
    color: var(--color-paper-sage-text);
  }

  /* Remplissage pur, donc `live` — la reconnexion est un fait CONSTATÉ par le
     système, pas une action à prendre. « The Two Voices Rule ». */
  .reconnect-dot {
    height: 7px;
    width: 7px;
    flex: none;
    border-radius: 999px;
    background: var(--color-live);
  }

  .foot {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 12px;
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
  }

  .reconcile-mock--warm .foot {
    border-top-color: var(--color-paper-rule);
  }

  .total {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }

  @media (max-width: 560px) {
    .block {
      grid-template-columns: 40px 48px minmax(0, 1fr) auto;
      gap: 7px;
    }

    .reconnect {
      font-size: 9px;
    }
  }
</style>
