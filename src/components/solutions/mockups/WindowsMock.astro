---
import CaptureThumb from "../../CaptureThumb.astro";
import { CAPTURE_VARIANTS } from "../../captures";
import { minutesOf } from "../../../data/solutions";

/** Les captures d'une heure, chacune avec son activité — l'atome de la mesure,
 * comptable.
 *
 * ─── Ce que la section demande ─────────────────────────────────────────────
 *
 * Le lede d'`employee-productivity` ouvre là-dessus : « Each screenshot carries
 * the keyboard and mouse activity of the minute before it, and by default the
 * agent asks before it pauses for idle. A visible indicator shows when the
 * timer is running. »
 *
 * Trois faits, trois choses à dessiner : la capture et son activité, le
 * ralenti, et l'indicateur visible.
 *
 * ─── Pourquoi des vignettes et plus une grille de soixante cases ───────────
 *
 * La première version dessinait soixante « fenêtres d'une minute ». L'agent
 * n'enregistre pas de série minute par minute (23 novembre 2026) : il prend une
 * capture à intervalle aléatoire et y joint l'activité clavier / souris de la
 * minute qui précède. La carte montre donc ce que montre la galerie du produit
 * — des vignettes horodatées, chacune avec son pourcentage.
 *
 * Elle SE COMPTE toujours : le nombre de captures, l'activité moyenne et la
 * durée du ralenti sont DÉRIVÉS des données. Le ralenti est un TROU entre deux
 * captures, situé à son heure, pas une rangée de cases.
 *
 * ⚠️ L'indicateur visible est SUR la carte, en haut, comme il est en haut du
 * produit. Sur une page dont le H1 est « Measure openly », la visibilité de la
 * mesure se voit ou ne vaut rien.
 */
interface Props {
  label: string;
  indicator: string;
  captures: { at: string; activity: number }[];
  idle?: { from: string; to: string };
  foot: string;
  /** Traitement Layered Paper — voir `DESIGN.md`, « Layered Paper Card ». */
  warm?: boolean;
  /** Bande sombre : seule l'ombre change, la feuille reste claire. */
  onDark?: boolean;
}

const { label, indicator, captures, idle, foot, warm = false, onDark = false } = Astro.props;

if (captures.length < 6) {
  throw new Error(
    `[solutions] WindowsMock attend au moins 6 captures, ${captures.length} reçues. ` +
      `Une heure à l'intervalle par défaut (3–5 min) en compte une douzaine ou plus.`
  );
}

/** `HH:MM` → minutes depuis minuit. `minutesOf` lit `H:MM`, ce qui couvre aussi
 *  une heure d'horloge, et lève sur une valeur illisible. */
const clock = (value: string) => minutesOf(value);

const average = Math.round(
  captures.reduce((sum, capture) => sum + capture.activity, 0) / captures.length
);
const idleMinutes = idle ? clock(idle.to) - clock(idle.from) : 0;

if (idle && idleMinutes <= 0) {
  throw new Error(
    `[solutions] WindowsMock : le ralenti ne progresse pas dans le temps (${idle.from} → ${idle.to}).`
  );
}

if (idle && captures.some((capture) => clock(capture.at) > clock(idle.from) && clock(capture.at) < clock(idle.to))) {
  throw new Error(
    `[solutions] WindowsMock : une capture tombe pendant le ralenti ${idle.from} → ${idle.to}. ` +
      `Le trou doit être un trou.`
  );
}

/** La rangée de vignettes, avec le trou du ralenti inséré à son heure. */
type Tile = { kind: "shot"; at: string; activity: number; n: number } | { kind: "idle" };
const tiles: Tile[] = [];
let idlePlaced = !idle;
captures.forEach((capture, n) => {
  if (!idlePlaced && idle && clock(capture.at) >= clock(idle.to)) {
    tiles.push({ kind: "idle" });
    idlePlaced = true;
  }
  tiles.push({ kind: "shot", at: capture.at, activity: capture.activity, n });
});
if (!idlePlaced) tiles.push({ kind: "idle" });
---

<div
  class:list={[
    "windows-mock rounded-[8px] border border-rule bg-white p-[18px]",
    { "windows-mock--warm": warm, "windows-mock--dark": warm && onDark },
  ]}
>
  <header class="head">
    <p class="label label-mono text-[10px] text-slate">{label}</p>

    {/* La garantie no 1 de la page, dessinée : l'indicateur est VISIBLE. */}
    <span class="indicator">
      <span class="indicator-dot" aria-hidden="true"></span>
      {indicator}
    </span>
  </header>

  {/* Les captures de l'heure, horodatées, chacune avec l'activité de la minute
      qui la précède. Le ralenti est un trou à son heure. */}
  <ol class="tiles">
    {
      tiles.map((tile) =>
        tile.kind === "shot" ? (
          <li class="tile" data-use-case-motion-row>
            <span class="thumb" aria-hidden="true">
              <CaptureThumb variant={CAPTURE_VARIANTS[tile.n % CAPTURE_VARIANTS.length]} />
            </span>
            <span class="tile-meta">
              <span class="tile-at">{tile.at}</span>
              <span class="tile-activity">{tile.activity}%</span>
            </span>
          </li>
        ) : (
          <li class="tile tile--idle" data-use-case-motion-row>
            <span class="idle-box">
              <span class="idle-range">
                {idle?.from}–{idle?.to}
              </span>
              <span class="idle-note">idle · not counted</span>
            </span>
          </li>
        )
      )
    }
  </ol>

  <dl class="legend">
    <div class="legend-row">
      <dt><span class="swatch swatch--active" aria-hidden="true"></span>Average activity</dt>
      <dd>{average}%</dd>
    </div>
    {
      idle && (
        <div class="legend-row">
          <dt><span class="swatch swatch--idle" aria-hidden="true"></span>Idle · asked, not counted</dt>
          <dd>{idleMinutes} min</dd>
        </div>
      )
    }
  </dl>

  <footer class="foot">
    <span class="count">{captures.length} screenshots</span>
    <span class="note">{foot}</span>
  </footer>
</div>

<style>
  .windows-mock--warm {
    border: 0;
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
  }

  .windows-mock--dark {
    box-shadow: var(--shadow-paper-card-dark);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .windows-mock--warm .label,
  .windows-mock--warm .note,
  .windows-mock--warm .legend dd {
    color: var(--color-paper-label);
  }

  .indicator {
    display: flex;
    flex: none;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    background: var(--color-band-mint);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-live-on-light);
  }

  .windows-mock--warm .indicator {
    background: var(--color-paper-sage);
    color: var(--color-paper-sage-text);
  }

  /* Remplissage pur, donc `live` — la règle de `global.css`. */
  .indicator-dot {
    height: 7px;
    width: 7px;
    border-radius: 999px;
    background: var(--color-live);
  }

  /* Les vignettes de l'heure. Quatre par rangée : assez grandes pour se lire
     comme des écrans, assez nombreuses pour qu'une heure se compte. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
  }

  .windows-mock--warm .thumb {
    border-color: var(--color-paper-rule);
    --cap-surface: var(--color-paper-surface);
    --cap-chrome: var(--color-paper-chip);
    --cap-mark: var(--color-paper-layer-light);
  }

  .tile-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-variant-numeric: tabular-nums;
  }

  .tile-at {
    color: var(--color-slate);
  }

  .windows-mock--warm .tile-at {
    color: var(--color-paper-label);
  }

  .tile-activity {
    font-weight: 600;
    color: var(--color-live-on-light);
  }

  /* ⚠️ Le ralenti n'est pas une case vide. Le produit le SIGNALE — il demande
     avant de mettre en pause — donc le trou porte une marque et son heure. Un
     blanc dirait « rien enregistré », ce qui est l'histoire de `SilenceMock`
     et pas celle-ci. */
  .idle-box {
    display: grid;
    aspect-ratio: 16 / 10;
    align-content: center;
    gap: 2px;
    border: 1px dashed var(--color-hour);
    border-radius: 3px;
    padding: 4px;
    text-align: center;
  }

  .idle-range {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .idle-note {
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-slate);
  }

  .windows-mock--warm .idle-note {
    color: var(--color-paper-label);
  }

  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .legend {
    display: grid;
    gap: 6px;
    margin: 14px 0 0;
  }

  .legend-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .legend dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }

  .windows-mock--warm .legend dt {
    color: var(--color-paper-label);
  }

  .legend dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .swatch {
    height: 9px;
    width: 9px;
    flex: none;
    border-radius: 1px;
  }

  .swatch--active {
    background: var(--color-live);
  }

  .swatch--idle {
    background: var(--color-hour);
    opacity: 0.55;
  }

  .foot {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 12px;
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
  }

  .windows-mock--warm .foot {
    border-top-color: var(--color-paper-rule);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }
</style>
