---
/** Les fenêtres de 60 secondes — l'atome de la mesure, comptable.
 *
 * ─── Ce que la section demande ─────────────────────────────────────────────
 *
 * Le lede d'`employee-productivity` ouvre là-dessus : « Activity is measured in
 * 60-second windows and idle time is flagged with a prompt, never deduced
 * quietly. A visible indicator shows when the timer is running. »
 *
 * Trois faits, trois choses à dessiner : la granularité, le ralenti signalé, et
 * l'indicateur visible. Une carte de score n'en portait aucun — elle posait
 * `88/100` sur vingt-quatre barres anonymes, exactement le défaut relevé en
 * revue (`docs/mockup-corrections.md`).
 *
 * ─── Pourquoi une grille et pas un histogramme ─────────────────────────────
 *
 * Parce qu'elle SE COMPTE. Soixante carrés font une heure, et le lecteur peut
 * le vérifier sur la carte — c'est la première exigence du test d'acceptation.
 * Un histogramme de hauteurs variables ne se compte pas : il se regarde, et un
 * opérateur méfiant ne croit pas ce qu'il ne peut pas vérifier.
 *
 * Le compte de fenêtres et celui des ralentis sont DÉRIVÉS du tableau. Ajouter
 * une fenêtre au ralenti met l'étiquette à jour toute seule.
 *
 * ⚠️ L'indicateur visible est SUR la carte, en haut, comme il est en haut du
 * produit. Sur une page dont le H1 est « Measure openly », la visibilité de la
 * mesure se voit ou ne vaut rien.
 */
interface Props {
  label: string;
  indicator: string;
  cells: (number | null)[];
  foot: string;
  /** Traitement Layered Paper — voir `DESIGN.md`, « Layered Paper Card ». */
  warm?: boolean;
  /** Bande sombre : seule l'ombre change, la feuille reste claire. */
  onDark?: boolean;
}

const { label, indicator, cells, foot, warm = false, onDark = false } = Astro.props;

/** Une heure pile. Le dessin ne vaut que si le compte tombe juste : sa promesse
 *  est qu'on peut le vérifier à l'écran. */
const WINDOWS_PER_HOUR = 60;

if (cells.length !== WINDOWS_PER_HOUR) {
  throw new Error(
    `[solutions] WindowsMock attend ${WINDOWS_PER_HOUR} fenêtres (une heure), ${cells.length} reçues. ` +
      `La carte annonce « ${WINDOWS_PER_HOUR} windows · one hour » et ce compte doit être vérifiable à l'écran : ` +
      `c'est toute la raison d'être d'une grille plutôt que d'un histogramme.`
  );
}

const idle = cells.filter((value) => value === null).length;
const active = cells.length - idle;

/** Deux tons seulement : enregistré, ou au ralenti. La question de cette carte
 *  est « est-ce mesuré », pas « combien ». Une échelle de vert ferait un damier
 *  — le bruit retiré de `SilenceMock` pour la même raison. L'intensité passe par
 *  l'opacité, qui module sans introduire de troisième couleur. */
const shade = (value: number) => 0.35 + (value / 100) * 0.65;

/** ⚠️ DÉCOUPÉ EN QUARTS D'HEURE, et étiqueté.
 *
 *  Soixante carrés d'un bloc se lisent comme un graphe de contributions — le
 *  motif générique par excellence, et le reproche exact de la revue. Quatre
 *  rangées nommées `:00 :15 :30 :45` en font une HORLOGE : la structure du
 *  temps devient visible, le ralenti se situe (« vers la demie »), et le compte
 *  de soixante se vérifie d'un coup d'oeil — quatre fois quinze.
 *
 *  Même leçon que l'axe de `SilenceMock` : une grille sans repère de temps ne
 *  se situe pas, donc elle ne se lit pas. */
const QUARTER = 15;
const quarters = Array.from({ length: cells.length / QUARTER }, (_, row) => ({
  label: `:${String(row * QUARTER).padStart(2, "0")}`,
  cells: cells.slice(row * QUARTER, (row + 1) * QUARTER),
}));
---

<div
  class:list={[
    "windows-mock rounded-[8px] border border-rule bg-white p-[18px]",
    { "windows-mock--warm": warm, "windows-mock--dark": warm && onDark },
  ]}
>
  <header class="head">
    <p class="label label-mono text-[10px] text-slate">{label}</p>

    {/* La garantie no 1 de la page, dessinée : l'indicateur est VISIBLE. */}
    <span class="indicator">
      <span class="indicator-dot" aria-hidden="true"></span>
      {indicator}
    </span>
  </header>

  {/* Soixante carrés, en quatre quarts d'heure nommés. Comptables, c'est le
      point — et situables, ce qui est l'autre moitié du point. */}
  <div class="grid" aria-hidden="true">
    {
      quarters.map((quarter) => (
        <div class="quarter">
          <span class="quarter-label">{quarter.label}</span>
          <div class="quarter-cells">
            {quarter.cells.map((value) =>
              value === null ? (
                <span class="cell cell--idle" />
              ) : (
                <span class="cell" style={`opacity:${shade(value)}`} />
              )
            )}
          </div>
        </div>
      ))
    }
  </div>

  <dl class="legend">
    <div class="legend-row">
      <dt><span class="swatch swatch--active" aria-hidden="true"></span>Recorded</dt>
      <dd>{active} windows</dd>
    </div>
    <div class="legend-row">
      <dt><span class="swatch swatch--idle" aria-hidden="true"></span>Idle · prompted</dt>
      <dd>{idle} windows</dd>
    </div>
  </dl>

  <footer class="foot">
    <span class="count">{cells.length} windows</span>
    <span class="note">{foot}</span>
  </footer>
</div>

<style>
  .windows-mock--warm {
    border: 0;
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
  }

  .windows-mock--dark {
    box-shadow: var(--shadow-paper-card-dark);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .windows-mock--warm .label,
  .windows-mock--warm .note,
  .windows-mock--warm .legend dd {
    color: var(--color-paper-label);
  }

  .indicator {
    display: flex;
    flex: none;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    background: var(--color-band-mint);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-live-on-light);
  }

  .windows-mock--warm .indicator {
    background: var(--color-paper-sage);
    color: var(--color-paper-sage-text);
  }

  /* Remplissage pur, donc `live` — la règle de `global.css`. */
  .indicator-dot {
    height: 7px;
    width: 7px;
    border-radius: 999px;
    background: var(--color-live);
  }

  /* Quatre quarts d'heure étiquetés, quinze fenêtres chacun. Un carré par
     fenêtre de 60 secondes. */
  .grid {
    display: grid;
    gap: 5px;
    margin-top: 16px;
  }

  .quarter {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    align-items: center;
    gap: 9px;
  }

  .quarter-label {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-slate);
    font-variant-numeric: tabular-nums;
  }

  .windows-mock--warm .quarter-label {
    color: var(--color-paper-label);
  }

  .quarter-cells {
    display: grid;
    grid-template-columns: repeat(15, minmax(0, 1fr));
    gap: 3px;
  }

  /* Rectangles plutôt que carrés : une fenêtre est une TRANCHE DE TEMPS, et une
     rangée de carrés pleins fait le pavé de graphe de contributions qu'on
     cherche à éviter. */
  .cell {
    height: 14px;
    border-radius: 1px;
    background: var(--color-live);
  }

  /* ⚠️ Le ralenti n'est pas une case vide. Le produit le SIGNALE — il demande
     au lieu de déduire — donc la case porte une marque plutôt qu'un blanc. Une
     case vide dirait « rien enregistré », ce qui est l'histoire de
     `SilenceMock` et pas celle-ci. */
  .cell--idle {
    height: 14px;
    border-radius: 1px;
    background: var(--color-hour);
    opacity: 0.55;
  }

  .legend {
    display: grid;
    gap: 6px;
    margin: 14px 0 0;
  }

  .legend-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .legend dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }

  .windows-mock--warm .legend dt {
    color: var(--color-paper-label);
  }

  .legend dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .swatch {
    height: 9px;
    width: 9px;
    flex: none;
    border-radius: 1px;
  }

  .swatch--active {
    background: var(--color-live);
  }

  .swatch--idle {
    background: var(--color-hour);
    opacity: 0.55;
  }

  .foot {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 12px;
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
  }

  .windows-mock--warm .foot {
    border-top-color: var(--color-paper-rule);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }
</style>
