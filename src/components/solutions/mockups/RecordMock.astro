---
import { CONTACTS } from "../../../data/site";

/** Le dossier client, paramétré.
 *
 *  Frère de `product/mockups/ClientMock.astro`, qui est figé sur l'exemple unique
 *  de la fiche technique (Northwind, 48 000 $, trois contacts partagés avec
 *  l'accueil). Ici chaque secteur amène SON vocabulaire — une matière juridique,
 *  un mandat de recrutement, une phase de chantier — et c'est précisément ce qui
 *  distingue huit pages d'un gabarit permuté. D'où un composant à props plutôt
 *  qu'un import : figer le dessin ici reviendrait à écrire huit fois la même page.
 *
 *  Grammaire des cartes du site, inchangée : identité → filet → personnes →
 *  filet → chiffres → filet → étiquettes. */
interface Props {
  title: string;
  chip: string;
  /** Les trois contacts partagés. Absents quand la carte parle d'un dossier et
   *  non d'un compte — un dossier de chantier n'a pas d'avatars. */
  people?: boolean;
  meter?: { label: string; value: string; percent: number; read: string };
  foot?: string;
  tags?: string[];
  warm?: boolean;
}

const { title, chip, people = false, meter, foot, tags, warm = false } = Astro.props;

/** Une jauge pleine ou dépassée passe à l'ambre : c'est l'état « attention »,
 *  pas l'état « conforme ». Le relevé qui l'accompagne suit — mais en `ink`, car
 *  l'ambre sur blanc ne fait que 1,98:1 dès qu'il porte du texte. */
const over = meter ? meter.percent >= 100 : false;
const fill = over ? "var(--color-hour)" : "var(--color-live-on-light)";
const width = meter ? Math.min(meter.percent, 100) : 0;
---

<div
  class:list={[
    "record-mock rounded-[8px] border border-rule bg-white p-5",
    { "record-mock--warm": warm },
  ]}
>
  <div class="flex items-center justify-between gap-3">
    <p class="font-display text-[17px] font-bold">{title}</p>
    <span
      class="record-chip shrink-0 rounded-[3px] bg-hour px-2 py-[4px] font-mono text-[10px] font-bold text-ink"
    >
      {chip}
    </span>
  </div>

  {
    people && (
      <ul class="record-people mt-4 space-y-[9px] border-t border-rule pt-4">
        {CONTACTS.map((contact) => (
          <li class="flex items-center gap-[11px]">
            <span
              class="grid h-[26px] w-[26px] shrink-0 place-items-center rounded-full font-mono text-[9px] text-white"
              style={`background:${contact.tone}`}
            >
              {contact.initials}
            </span>
            <span class="text-[13.5px] font-medium">{contact.name}</span>
            <span class="font-mono text-[11px] text-slate">{contact.role}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    meter && (
      <div class="record-meter mt-4 border-t border-rule pt-4">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[11px] text-slate">{meter.label}</span>
          <span class="font-mono text-[15px] font-bold">{meter.value}</span>
        </div>

        <span class="meter-track mt-2 block h-[6px] overflow-hidden rounded-full bg-paper">
          <span class="block h-full" style={`width:${width}%;background:${fill}`} />
        </span>

        <p
          class:list={[
            "mt-[6px] text-right font-mono text-[11px]",
            over ? "text-ink" : "text-live-on-light",
          ]}
        >
          {meter.read}
        </p>
      </div>
    )
  }

  {
    foot && (
      <p class="record-foot mt-4 border-t border-rule pt-4 font-mono text-[11px] text-slate">
        {foot}
      </p>
    )
  }

  {
    tags && tags.length > 0 && (
      <div class="record-tags mt-4 flex flex-wrap gap-2 border-t border-rule pt-4">
        {tags.map((tag) => (
          <span class="record-tag rounded-[3px] border border-rule px-2 py-[3px] font-mono text-[10px] text-slate">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  .record-mock--warm {
    border: 0;
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
  }

  .record-mock--warm .record-chip {
    border-radius: 999px;
    padding-inline: 10px;
  }

  .record-mock--warm .record-people,
  .record-mock--warm .record-meter,
  .record-mock--warm .record-foot,
  .record-mock--warm .record-tags {
    border-color: var(--color-paper-rule);
  }

  .record-mock--warm .meter-track {
    background: var(--color-paper-track);
  }

  .record-mock--warm .record-tag {
    border: 0;
    border-radius: 999px;
    background: var(--color-paper-chip);
    padding-inline: 10px;
  }
</style>
