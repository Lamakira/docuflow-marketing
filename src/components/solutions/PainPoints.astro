---
import FaultsArt from "../art/FaultsArt.astro";

interface Props {
  heading: string;
  points: { title: string; body: string }[];
  /** « The problem » sur une page secteur, « The situation » sur une page cas
   *  d'usage. Texte seul, jamais de ton : l'oeil-de-boeuf est en `ink` ici pour
   *  une raison de contraste (voir plus bas), et un ton paramétrable rouvrirait
   *  la porte à l'ambre sur blanc. */
  eyebrow?: string;
}

const { heading, points, eyebrow = "The problem" } = Astro.props;

/** ⚠️ EXACTEMENT trois points. La grille est en `grid-cols-3` et le dessin
 *  d'en-tête (`FaultsArt`) montre trois ruptures — « trois marques ambre pour
 *  les trois points numérotés juste en dessous ». Un quatrième point laisserait
 *  un orphelin en deuxième rangée ET ferait mentir l'illustration, sans que
 *  rien ne le signale. */
if (points.length !== 3) {
  throw new Error(
    `[solutions] PainPoints attend 3 points, ${points.length} reçus (« ${heading} »). ` +
      `La grille et FaultsArt sont bâtis sur trois.`
  );
}
---

{/* LA section qui décide si la page est une doorway page.
    Si ces trois phrases se lisent correctement sur la page d'un autre secteur,
    la page a échoué et se réécrit — c'est écrit dans `src/data/solutions.ts`, et
    c'est ici que ça se voit.

    Registre éditorial, pas des cartes : un filet 1 px en haut de chaque point,
    numéro en mono. Les encadrer en ferait trois boîtes qui se ressemblent, alors
    que le sujet de la section est justement qu'elles ne se ressemblent pas.

    Oeil-de-boeuf en `ink` : sur blanc l'ambre ne fait que 1,90:1, sa pire
    surface du site. Voir la table `EYEBROW_TONE` de `solutions.ts`. */}
<section class="bg-white py-[88px]" data-reveal-group>
  <div class="container-wide">
    {/* En-tête sur deux colonnes, les trois points restent pleine largeur en
        dessous. Le dessin est le même sur les huit pages : il montre la FORME
        d'un relevé troué, pas le problème d'un secteur — inventer huit
        situations serait inventer huit fois. */}
    <div
      class="grid grid-cols-1 items-center gap-14 min-[901px]:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]"
    >
      <div>
        <p class="label-mono text-[11px] text-ink" data-reveal>{eyebrow}</p>

        <h2 class="mt-4 max-w-[20ch] text-[clamp(28px,4vw,42px)]" data-reveal>{heading}</h2>
      </div>

      {/* Le dessin par défaut — un relevé troué de trois marques — sert les huit
          pages secteur, où le sujet EST « le dossier a des trous ».
          Une page cas d'usage passe le sien : son sujet est nommé (facturation,
          télétravail, rentabilité…) et le lecteur doit le reconnaître avant
          d'avoir lu une ligne. Un dessin identique sur quatorze pages ne dit
          rien d'aucune. */}
      <div class="hidden min-[901px]:block" data-use-case-motion-card>
        <slot name="art"><FaultsArt /></slot>
      </div>
    </div>

    <ol class="mt-12 grid grid-cols-1 gap-x-14 gap-y-0 min-[901px]:grid-cols-3" data-reveal>
      {
        points.map((point, i) => (
          <li class="border-t border-rule pt-6">
            <p class="font-mono text-[11px] text-slate-on-ink" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <p class="mt-3 max-w-[26ch] font-display text-[19px] font-bold leading-[1.25] tracking-[-0.02em]">
              {point.title}
            </p>
            <p class="mt-3 max-w-[42ch] text-[15px] leading-[1.6] text-slate">{point.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Sous 901px les trois points s'empilent : le filet du haut suffit à les
     séparer, mais il faut rendre l'espace que la gouttière portait. */
  @media (max-width: 900px) {
    li + li {
      margin-top: 28px;
    }
  }
</style>

<script>
  import "../../scripts/reveal";
</script>
