---
/**
 * `/solutions/employee-productivity` — section « the situation ».
 *
 * Les fenêtres d'activité d'une minute, et au moment où elles retombent, le
 * PROMPT plutôt qu'une déduction silencieuse. C'est la distinction que toute la
 * page défend : mesurer à découvert, pas en douce.
 *
 * Valeurs du scénario (seuil 3 min, prompt à 11:04, 6 min d'inactivité).
 */
const WINDOWS = [
  72, 88, 64, 91, 55, 78, 83, 60, 74, 86, 12, 6, 4, 8, 5, 68, 81, 59, 77, 90,
];
/** Les fenêtres creuses qui déclenchent le prompt — index 10 à 14. */
const IDLE_FROM = 10;
const IDLE_TO = 14;
---

<div class="idle" data-art>
  <header class="head" data-art-in>
    <span class="label">Activity · 60-second windows</span>
    <span class="stamp">11:04</span>
  </header>

  <div class="bars" aria-hidden="true">
    {
      WINDOWS.map((value, i) => (
        <span
          class:list={["bar", { quiet: i >= IDLE_FROM && i <= IDLE_TO }]}
          style={`height:${value}%`}
          data-art-grow
        />
      ))
    }
  </div>

  {/* Le prompt : ce qui arrive à la place d'une soustraction silencieuse. */}
  <div class="prompt" data-art-pop data-use-case-motion-row>
    <span class="mark" aria-hidden="true"></span>
    <span class="text">
      <span class="title">Still there?</span>
      <span class="sub">6 min idle · past the 3 min threshold</span>
    </span>
    <span class="count">0:20</span>
  </div>
</div>

<style>
  .idle {
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: #fff;
    padding: 14px 18px 16px;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .stamp {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 40px;
    margin-top: 16px;
  }

  .bar {
    flex: 1;
    border-radius: 2px;
    background: var(--color-live);
    transform-origin: 50% 100%;
  }

  /* Les fenêtres creuses restent neutres : « rien n'a été tapé » n'est pas un
     défaut, c'est une observation. */
  .quiet {
    background: var(--color-rule);
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 16px;
    border-radius: 6px;
    background: var(--color-paper);
    padding: 11px 13px;
  }

  .mark {
    height: 10px;
    width: 10px;
    flex: none;
    border-radius: 2px;
    background: var(--color-hour);
  }

  .text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .title {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .sub {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }

  /* Le compte à rebours : la personne a le temps de répondre. */
  .count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import "../../scripts/art";
</script>
