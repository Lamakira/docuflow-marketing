---
/**
 * `/solutions/hybrid-teams` — section « objection » (frontières).
 *
 * Une journée de 24 h : la fenêtre active est pleine, le reste est vide, et
 * 21:00 porte la mention « nothing captured ». C'est la promesse de la section
 * rendue vérifiable d'un coup d'oeil — la fin de journée est un réglage
 * visible, pas un jugement rendu après coup.
 *
 * La fenêtre 09:00–18:00 est un EXEMPLE de configuration, pas un défaut
 * produit : le libellé le dit.
 *
 * ─── Ce qui a changé le 30 juillet 2026 ────────────────────────────────────
 *
 * 1. **Layered Paper.** La carte était blanche et plate sur une page passée au
 *    papier chaud.
 * 2. **Le fait lui appartient en propre.** La maquette du pilier 02 (`device`)
 *    portait une ligne « Active hours · 09:00 – 18:00 » : la page énonçait donc
 *    la même limite deux fois, et ce dessin ne faisait que répéter une ligne
 *    déjà lue. La ligne a été retirée de la carte du poste. **Un fait, un seul
 *    endroit** — ici, où il est le sujet entier.
 * 3. **Les heures se comptent.** Le compte d'heures capturables est DÉRIVÉ de
 *    la fenêtre, et celui des heures hors fenêtre s'en déduit. Sur une section
 *    qui promet que « nothing is recorded outside it », le lecteur doit pouvoir
 *    vérifier combien d'heures ce « outside » représente.
 */
const START = 9;
const END = 18;
/** L'heure citée par la copy de la section : le portable rouvert le soir. */
const LATE = 21;

const HOURS = Array.from({ length: 24 }, (_, hour) => hour);

/** Dérivés de la fenêtre : jamais retapés, sinon changer `START` laisserait un
 *  compte faux à l'écran. */
const capturable = END - START;
const outside = HOURS.length - capturable;

const pad = (hour: number) => `${String(hour).padStart(2, "0")}:00`;
---

{/* THESIS: capture has an edge, the edge is a setting, and the evening is on the
    far side of it. OWN-WORLD: a warm day strip on paper, most of it empty by
    design. STORY: find the filled window, count what is outside it, land on the
    evening hour that recorded nothing. FIRST VIEWPORT: the strip; the late hour
    closes it. FORM: standalone Layered Paper — the page's situation
    illustration is a tally of totals, so this one is a day. */}
<div class="window-stage" data-art>
  <span class="sheet-backing backing-one" aria-hidden="true"></span>
  <span class="sheet-backing backing-two" aria-hidden="true"></span>

  <section class="window-card" aria-label={`Capture window, ${pad(START)} to ${pad(END)}`}>
    <header class="head" data-art-in>
      <span class="label">Active hours · your setting</span>
      <span class="range">{pad(START)} – {pad(END)}</span>
    </header>

    <div class="strip" aria-hidden="true">
      {
        HOURS.map((hour) => (
          <span
            class:list={["slot", { on: hour >= START && hour < END, late: hour === LATE }]}
            data-art-grow
          />
        ))
      }
    </div>

    <div class="ticks" aria-hidden="true">
      <span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
    </div>

    {/* Les deux comptes, dérivés de la fenêtre. C'est ce qui rend « nothing is
        recorded outside it » vérifiable au lieu d'être promis : seize heures sur
        vingt-quatre ne sont jamais capturables, et ça se lit. */}
    <dl class="counts" data-art-in>
      <div class="count">
        <dt>Capturable</dt>
        <dd>{capturable} h</dd>
      </div>
      <span class="count-sep" aria-hidden="true"></span>
      <div class="count">
        <dt>Never captured</dt>
        <dd>{outside} h</dd>
      </div>
    </dl>

    {/* Le point de la section : hors fenêtre, rien n'est enregistré. */}
    <footer class="foot" data-art-pop data-use-case-motion-row>
      <span class="mark" aria-hidden="true"></span>
      {pad(LATE)} · laptop open, nothing captured
    </footer>
  </section>
</div>

<style>
  /* Scène transparente — padding SEULEMENT. Une carte seule ne s'assied jamais
     dans une autre carte ; les deux feuilles derrière elle SONT la profondeur. */
  .window-stage {
    position: relative;
    padding: 14px 16px 18px;
  }

  .sheet-backing {
    position: absolute;
    inset: 20px 20px 14px;
    border-radius: var(--radius-paper-card);
    transition: transform var(--paper-motion-duration) var(--paper-motion-ease);
  }

  .backing-one {
    background: var(--color-paper-layer);
    transform: translate(-7px, 5px) rotate(-2.4deg);
  }

  .backing-two {
    background: var(--color-paper-layer-light);
    transform: translate(6px, 3px) rotate(1.7deg);
  }

  .window-card {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
    padding: 15px 18px 16px;
    transition:
      transform var(--paper-motion-duration) var(--paper-motion-ease),
      box-shadow var(--paper-motion-duration) var(--paper-motion-ease);
    transform: rotate(-0.6deg);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper-label);
  }

  .range {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 2px;
    height: 30px;
    margin-top: 14px;
  }

  /* Hors fenêtre : une piste vide, pas une barre courte. Rien n'y est
     enregistré — même distinction que les emplacements vides de `ThinWeekArt`. */
  .slot {
    align-self: stretch;
    border-radius: 1px;
    background: var(--color-paper-track);
    transform-origin: 50% 100%;
  }

  .slot.on {
    background: var(--color-live);
  }

  /* L'heure citée par la copy. Ambre : c'est le seul de l'écran, et il marque
     l'instant que la section demande de regarder. */
  .slot.late {
    background: var(--color-hour);
  }

  .ticks {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-paper-label);
  }

  .counts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    margin: 14px 0 0;
    border-radius: var(--radius-paper-inset);
    background: var(--color-paper-chip);
    padding: 12px 14px;
  }

  .count {
    display: grid;
    min-width: 0;
    gap: 4px;
  }

  .count dt {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper-label);
  }

  .count dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .count-sep {
    align-self: stretch;
    background: var(--color-paper-rule);
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 12px;
    border-top: 1px solid var(--color-paper-rule);
    padding-top: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-paper-label);
  }

  .mark {
    height: 8px;
    width: 8px;
    flex: none;
    border-radius: 2px;
    background: var(--color-hour);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .window-stage:hover .backing-one {
      transform: translate(-13px, 8px) rotate(-3.8deg);
    }

    .window-stage:hover .backing-two {
      transform: translate(10px, 5px) rotate(2.8deg);
    }

    .window-stage:hover .window-card {
      box-shadow: var(--shadow-paper-card-hover);
      transform: translateY(-5px) rotate(0deg);
    }
  }

  @media (max-width: 1100px) {
    .window-stage {
      padding: 10px 11px 14px;
    }

    .sheet-backing {
      inset: 15px 15px 10px;
    }

    .window-card {
      padding-inline: 14px;
    }
  }
</style>

<script>
  import "../../scripts/art";
</script>
