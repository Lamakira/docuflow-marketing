---
/**
 * `/solutions/hybrid-teams` — section « objection » (frontières).
 *
 * Une journée de 24 h en barres : la fenêtre active est pleine, le reste est
 * gris, et 21:00 porte la mention « no capture ». C'est la promesse de la
 * section rendue vérifiable d'un coup d'oeil — la fin de journée est un réglage
 * visible, pas un jugement rendu après coup.
 *
 * La fenêtre 09:00–18:00 est un EXEMPLE de configuration, pas un défaut produit :
 * le libellé le dit.
 */
const START = 9;
const END = 18;
/** L'heure citée par la copy de la section : le portable rouvert le soir. */
const LATE = 21;

const HOURS = Array.from({ length: 24 }, (_, hour) => hour);
---

<div class="window" data-art>
  <header class="head" data-art-in>
    <span class="label">Active hours · your setting</span>
    <span class="range">09:00 – 18:00</span>
  </header>

  <div class="strip" aria-hidden="true">
    {
      HOURS.map((hour) => (
        <span
          class:list={["slot", { on: hour >= START && hour < END, late: hour === LATE }]}
          data-art-grow
        />
      ))
    }
  </div>

  <div class="ticks" aria-hidden="true">
    <span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
  </div>

  {/* Le point de la section : hors fenêtre, rien n'est enregistré. */}
  <footer class="foot" data-art-pop data-use-case-motion-row>
    <span class="mark"></span>
    21:00 · laptop open, nothing captured
  </footer>
</div>

<style>
  .window {
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: #fff;
    padding: 14px 18px 16px;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .range {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .strip {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 34px;
    margin-top: 16px;
  }

  /* Hors fenêtre : une trace, pas une absence — l'heure existe, elle n'est
     simplement pas enregistrée. */
  .slot {
    flex: 1;
    height: 40%;
    border-radius: 2px;
    background: var(--color-rule);
    transform-origin: 50% 100%;
  }

  .slot.on {
    height: 100%;
    background: var(--color-live-on-light);
  }

  /* L'heure citée par la copy, marquée en ambre : c'est le cas qu'on vient
     vérifier en lisant la section. */
  .slot.late {
    background: var(--color-hour);
  }

  .ticks {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-slate);
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 14px;
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
    font-size: 12.5px;
    color: var(--color-ink);
  }

  .mark {
    height: 10px;
    width: 10px;
    flex: none;
    border-radius: 2px;
    background: var(--color-hour);
  }
</style>

<script>
  import "../../scripts/art";
</script>
