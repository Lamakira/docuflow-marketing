---
/**
 * Illustration de la section « objection » — les huit pages secteur.
 *
 * ⚠️ Redessinée le 23 novembre 2026. Elle montrait une capture dont le contenu
 * était rayé, illisible : c'était le dessin de « Screenshots can be blurred so
 * content is never legible ». Ce floutage n'existe pas dans l'application — ni
 * dans l'agent, ni au serveur, ni dans la politique de suivi — et les huit
 * objections ont été réécrites sans lui. Le nom du fichier est resté pour ne pas
 * toucher `ObjectionSection` ; il ne décrit plus le dessin.
 *
 * Ce qu'elle dit maintenant, et que le produit fait vraiment : **la capture suit
 * le chronomètre.** Une piste : le segment vert est le chrono qui tourne, quatre
 * vignettes posées dessus ; un repère d'arrêt ; puis un segment gris sans une
 * seule vignette. Ça se compte — quatre captures, toutes dans le vert, zéro après
 * l'arrêt (`ScreenCaptureWorker` ne capture que pendant une entrée en cours).
 *
 * Le repère d'arrêt arrive en dernier (`data-art-pop`) : c'est lui qui porte
 * l'argument. Aucun texte, comme les autres dessins d'objection.
 *
 * Plus compacte que les autres (320×180) : elle se loge sous la colonne de texte,
 * en face des garanties, sans leur faire concurrence. Bande BLANCHE : la feuille
 * est donc `paper` cernée d'un filet.
 */

/** Les vignettes de capture, posées sur le segment « chrono en cours ». */
const SHOTS = [34, 72, 110, 148];
const RUN_END = 190;
---

<svg
  class="art"
  viewBox="0 0 320 180"
  fill="none"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  data-art
>
  <g data-art-in>
    <rect class="sheet" x="8" y="8" width="304" height="164" rx="8" />
    <rect class="bar" x="26" y="30" width="118" height="8" rx="4" />
  </g>

  {/* Les captures : uniquement au-dessus du segment où le chrono tourne. */}
  {
    SHOTS.map((x) => (
      <g data-art-in>
        <rect class="shot" x={x} y="62" width="30" height="22" rx="2" />
        <line class="shot-bar" x1={x} y1="67.5" x2={x + 30} y2="67.5" />
        <rect class="shot-line" x={x + 5} y="72" width="16" height="2" rx="1" />
        <rect class="shot-line" x={x + 5} y="77" width="11" height="2" rx="1" />
        <line class="tick" x1={x + 15} y1="84" x2={x + 15} y2="112" data-art-draw />
      </g>
    ))
  }

  {/* La piste : vert tant que le chrono tourne, gris ensuite. */}
  <g data-art-in>
    <rect class="run" x="26" y="112" width={RUN_END - 26} height="6" rx="3" />
    <rect class="idle" x={RUN_END + 6} y="112" width={294 - RUN_END - 6} height="6" rx="3" />
  </g>

  {/* Le repère d'arrêt — l'argument du dessin. */}
  <g data-art-pop>
    <line class="stop-line" x1={RUN_END + 3} y1="60" x2={RUN_END + 3} y2="128" />
    <rect class="stop" x={RUN_END - 3} y="50" width="12" height="12" rx="2" />
  </g>

  <g data-art-in>
    <rect class="bar" x="26" y="146" width="140" height="8" rx="4" />
  </g>
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Bande blanche : la feuille se creuse en `paper`. */
  .sheet {
    fill: var(--color-paper);
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .bar,
  .shot-line {
    fill: var(--color-rule);
  }

  .shot {
    fill: #fff;
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .shot-bar,
  .tick {
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  /* Remplissage pur, sans signe porté : `live` et non `live-on-light`. */
  .run {
    fill: var(--color-live);
  }

  .idle {
    fill: var(--color-rule);
  }

  .stop-line {
    stroke: var(--color-slate);
    stroke-width: 1;
  }

  .stop {
    fill: var(--color-slate);
  }
</style>

<script>
  import "../../scripts/art";
</script>
