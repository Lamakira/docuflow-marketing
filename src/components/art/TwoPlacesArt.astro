---
/**
 * `/solutions/hybrid-teams` — section « the situation ».
 *
 * Une seule feuille de temps, deux lieux, et au milieu la coupure de connexion
 * qui se recolle. Les puces OFFICE / HOME sont ce qui rend le sujet lisible au
 * premier coup d'oeil ; la rangée ambre est la coupure — le seul endroit où
 * quelque chose demande une action.
 *
 * Valeurs reprises du scénario de la page (13:40 → 14:02, 22 min).
 */
const ROWS = [
  { place: "office", task: "Workshop prep", duration: "2:10:00" },
  { place: "home", task: "Stakeholder calls", duration: "1:45:30" },
  { place: "home", task: "Offline · queued 13:40", duration: "0:22:00", gap: true },
  { place: "home", task: "Board pack revisions", duration: "1:32:07" },
];
---

<div class="sheet" data-art>
  <header class="head" data-art-in>
    <span class="label">Thursday</span>
    <span class="total">5:49:37</span>
  </header>

  <ul class="rows">
    {
      ROWS.map((row) => (
        <li class:list={{ gap: row.gap }} data-art-in data-use-case-motion-row>
          <span class:list={["place", row.place]}>{row.place}</span>
          <span class="task">{row.task}</span>
          <span class="dur">{row.duration}</span>
        </li>
      ))
    }
  </ul>

  {/* La réconciliation : ce que la coupure devient une fois la connexion revenue. */}
  <footer class="foot" data-art-pop>Reconnected 14:02 · counted once</footer>
</div>

<style>
  .sheet {
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: #fff;
    padding: 14px 18px 16px;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .total {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--color-rule);
    padding: 9px 0;
  }

  /* Les deux lieux, en puces de domaine — la grammaire des tags du site. */
  .place {
    flex: none;
    width: 52px;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    padding: 2px 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .task {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-slate);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dur {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* La coupure : l'unique note ambre, l'endroit où le relevé aurait pu mentir. */
  .gap .place {
    border-color: transparent;
    background: var(--color-hour);
    font-weight: 700;
    color: var(--color-ink);
  }

  .gap .task {
    color: var(--color-ink);
  }

  .foot {
    margin-top: 12px;
    border-top: 1px solid var(--color-rule);
    padding-top: 11px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-live-on-light);
  }
</style>

<script>
  import "../../scripts/art";
</script>
