---
/**
 * `/solutions/onboarding-documentation` — section « objection » (péremption).
 *
 * L'objection est « la documentation pourrit, et une page périmée est pire que
 * rien ». La réponse de la section est que la CITATION rend la péremption
 * visible : on voit la source ET sa date, donc on peut juger.
 *
 * D'où le dessin : une réponse, ses deux sources, et la date de chacune. L'une
 * est fraîche, l'autre a six mois et le dit — c'est le lecteur qui tranche,
 * ce qui est précisément l'argument.
 */
const SOURCES = [
  { kind: "doc", name: "Refunds policy", when: "Updated 6 days ago", stale: false },
  { kind: "call", name: "Onboarding Mar 6", when: "Recorded 6 months ago", stale: true },
];
---

<div class="cited" data-art>
  <p class="question" data-art-in>how do we handle a refund over $500?</p>

  <p class="answer" data-art-in>
    Tier 2 approves anything above $500, and the reason goes on the client record.
  </p>

  <ul class="sources">
    {
      SOURCES.map((source) => (
        <li data-art-in data-use-case-motion-row>
          <span class:list={["chip", { stale: source.stale }]}>
            {source.kind} · {source.name}
          </span>
          <span class="when">{source.when}</span>
        </li>
      ))
    }
  </ul>

  {/* Ce que les dates permettent : juger, plutôt que croire. */}
  <footer class="foot" data-art-pop>Every answer carries what it came from</footer>
</div>

<style>
  .cited {
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: #fff;
    padding: 16px 18px 16px;
  }

  /* La question est en mono : elle a été tapée dans le produit. */
  .question {
    border-radius: 6px;
    background: var(--color-paper);
    padding: 11px 13px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
  }

  .answer {
    margin-top: 13px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .sources {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .sources li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
  }

  /* La puce de source cerclée de vert : le motif du système pour « cette
     réponse est redevable ». */
  .chip {
    border: 1px solid var(--color-live-on-light);
    border-radius: 3px;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-live-on-light);
  }

  /* La source ancienne passe en ambre : elle n'est pas fausse, elle demande
     qu'on la regarde. C'est tout l'argument de la section — la péremption
     devient visible au lieu d'être invisible. */
  .chip.stale {
    border-color: var(--color-hour);
    color: var(--color-ink);
  }

  .when {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-slate);
  }

  .foot {
    margin-top: 10px;
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
</style>

<script>
  import "../../scripts/art";
</script>
