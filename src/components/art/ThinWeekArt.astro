---
/**
 * `/solutions/remote-teams` — section « the situation ».
 *
 * ─── Ce que ce dessin doit dire ────────────────────────────────────────────
 *
 * Le titre de la section est « A quiet week and an absent week look identical. »
 * Le dessin doit donc montrer DEUX SEMAINES QUI SE RESSEMBLENT, puis ce qui les
 * sépare — jamais deux semaines dont l'une est visiblement mauvaise. C'est la
 * faute que la première version commettait : la semaine creuse y avait cinq
 * petites barres grises, ce qui se lit « cette personne n'a rien fait ». La page
 * dit exactement l'inverse.
 *
 * Corrigé sur le troisième point de douleur, mot pour mot : « nothing separates
 * someone who was heads-down from someone whose agent stopped reporting on
 * Tuesday ». La semaine creuse porte donc deux jours ENREGISTRÉS puis trois
 * emplacements VIDES — un contour, pas une barre courte. Une barre courte est
 * une mesure basse ; un contour vide est une absence de mesure, et c'est
 * l'ambiguïté dont la section parle.
 *
 * ─── Layered Paper ─────────────────────────────────────────────────────────
 *
 * Scène multi-objets (`DESIGN.md`, « Multi-object scene ») : deux relevés
 * physiques posés côte à côte sur le même bureau, ce qui est littéralement le
 * geste que la section décrit — on les met l'un à côté de l'autre pour les
 * comparer. Le canevas est autorisé ici parce qu'il y a bien DEUX objets
 * positionnés indépendamment ; une carte seule n'y aurait pas droit.
 *
 * ⚠️ Les valeurs viennent de la page (`solutions.ts`, `remote-teams`) : 38 h et
 * 11 h du scénario, 84/STRONG du héros, 38/WEAK du scénario. Quatre endroits,
 * une seule vérité — si l'un bouge, les autres mentent.
 */

/** Cinq jours. `null` = aucun événement reçu, et c'est un état, pas un zéro :
 *  il se dessine en contour vide. Valeurs figées, jamais tirées au hasard —
 *  un `Math.random()` au build donnerait un dessin différent à chaque
 *  déploiement, donc une capture de recette jamais reproductible. */
const WEEKS = [
  {
    label: "Week 31",
    hours: "38 h",
    score: 84,
    grade: "STRONG",
    days: [70, 88, 64, 92, 76],
    note: null,
  },
  {
    label: "Week 32",
    hours: "11 h",
    score: 38,
    grade: "WEAK",
    /* ⚠️ Lundi et mardi sont des jours NORMAUX, du même ordre que ceux de la
       semaine 31. Deux barres basses suivies de vides raconteraient « peu de
       travail puis plus rien » — soit exactement la lecture que la section
       existe pour empêcher. Ce qui change n'est pas le niveau, c'est l'arrêt. */
    days: [72, 66, null, null, null],
    note: "Device silent since Tuesday",
  },
];

const [full, thin] = WEEKS;
---

{/* THESIS: two weeks that look alike on a dashboard are told apart by the score
    on the record, never by the size of the week. OWN-WORLD: two paper timesheets
    laid side by side on a warm desk. STORY: read the full week, read the thin
    one, find the empty slots, then read the grade. FIRST VIEWPORT: the full week
    sits back-left, the questioned week rises in front on the right. FORM: two
    overlapping records, paired with the billing desk illustration but composed
    around comparison rather than lineage. */}
<div class="week-desk" data-art>
  <header class="desk-head" data-art-in>
    <span class="desk-label">Evidence coverage</span>
    <span class="desk-ref">One person · two weeks</span>
  </header>

  <div class="desk-stage">
    <span class="sheet-backing backing-one" aria-hidden="true"></span>
    <span class="sheet-backing backing-two" aria-hidden="true"></span>

    <section class="week-card card-full" aria-label={`${full.label}, evidence quality ${full.score} out of 100`}>
      <div class="week-head" data-art-in>
        <span class="section-label">{full.label}</span>
        <span class="week-hours">{full.hours}</span>
      </div>

      <div class="days" aria-hidden="true">
        {full.days.map((value) => <span class="day" style={`height:${value}%`} data-art-grow />)}
      </div>

      <footer class="week-foot" data-art-in>
        <span class="score" data-art-pop>
          {full.score}<span class="of">/100</span>
        </span>
        <span class="grade grade-strong">{full.grade}</span>
      </footer>
    </section>

    <section class="week-card card-thin" aria-label={`${thin.label}, evidence quality ${thin.score} out of 100`}>
      <div class="week-head" data-art-in>
        <span class="section-label">{thin.label}</span>
        <span class="week-hours">{thin.hours}</span>
      </div>

      <div class="days" aria-hidden="true">
        {
          thin.days.map((value) =>
            value === null ? (
              <span class="day day-silent" data-art-in />
            ) : (
              <span class="day" style={`height:${value}%`} data-art-grow />
            )
          )
        }
      </div>

      <footer class="week-foot" data-art-in>
        <span class="score" data-art-pop>
          {thin.score}<span class="of">/100</span>
        </span>
        {/* Le seul ambre de l'écran — l'oeil-de-boeuf de cette section est en
            `ink`, donc la « One Amber Rule » laisse la place à celui-ci. Il
            marque l'état à vérifier : le poste, pas la personne. */}
        <span class="grade grade-weak">{thin.grade}</span>
      </footer>

      {/* La ligne qui désamorce la lecture « semaine vide = personne absente ».
          Elle porte l'argument, donc elle arrive en dernier. */}
      <p class="silent-note" data-art-pop data-use-case-motion-row>{thin.note}</p>
    </section>
  </div>
</div>

<style>
  .week-desk {
    position: relative;
    min-height: 326px;
    overflow: clip;
    border-radius: var(--radius-paper-scene);
    background: var(--color-paper-canvas);
    box-shadow: var(--shadow-paper-scene);
    padding: 16px 18px 18px;
  }

  .desk-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    position: relative;
    z-index: 7;
  }

  .desk-label,
  .desk-ref,
  .section-label,
  .week-hours,
  .silent-note {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-paper-label);
  }

  .desk-label,
  .section-label {
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .desk-stage {
    position: relative;
    height: 266px;
    margin-top: 8px;
  }

  .sheet-backing,
  .week-card {
    position: absolute;
    transition:
      transform var(--paper-motion-duration) var(--paper-motion-ease),
      box-shadow var(--paper-motion-duration) var(--paper-motion-ease);
  }

  .sheet-backing {
    left: 1%;
    top: 40px;
    width: 52%;
    height: 176px;
    border-radius: var(--radius-paper-card);
  }

  .backing-one {
    background: var(--color-paper-layer);
    transform: translate(-7px, 7px) rotate(-4.6deg);
  }

  .backing-two {
    background: var(--color-paper-layer-light);
    transform: translate(2px, 3px) rotate(2.2deg);
  }

  .week-card {
    border-radius: var(--radius-paper-card);
    background: var(--color-paper-surface);
    box-shadow: var(--shadow-paper-card);
    padding: 15px 16px 14px;
    min-width: 0;
  }

  /* La semaine pleine est EN ARRIÈRE : celle qu'on interroge est celle qu'on
     tient en main, et c'est la creuse.
     ⚠️ `padding-right` dégage la COUTURE. Les deux feuilles se chevauchent d'une
     vingtaine de pixels — c'est ce qui les fait lire comme deux objets posés et
     non comme une grille à deux colonnes — mais sans ce dégagement, la feuille
     de devant recouvre le badge `STRONG` et la cinquième barre de celle de
     derrière. Une feuille glissée sous une autre garde sa partie lisible à
     découvert ; c'est le geste, pas un rattrapage. */
  .card-full {
    z-index: 2;
    left: 1%;
    top: 32px;
    width: 55%;
    padding-right: 36px;
    transform: rotate(-1.9deg);
  }

  .card-thin {
    z-index: 4;
    right: 0;
    top: 18px;
    width: 46%;
    box-shadow: var(--shadow-paper-card-raised);
    transform: rotate(1.6deg);
  }

  .week-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .week-hours {
    font-size: 12px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .days {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 62px;
    margin-top: 14px;
  }

  .day {
    flex: 1;
    min-width: 0;
    border-radius: 2px;
    background: var(--color-live);
    transform-origin: 50% 100%;
  }

  /* ⚠️ Un contour vide, jamais une barre courte. Une barre courte se lit
     « peu de travail » ; ce jour-là il n'y a AUCUNE mesure, et toute la section
     tient sur cette différence. */
  .day-silent {
    height: 100%;
    border: 1px dashed var(--color-paper-layer);
    background: none;
  }

  .week-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 14px;
    border-top: 1px solid var(--color-paper-rule);
    padding-top: 12px;
  }

  .score {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .of {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-paper-label);
  }

  .grade {
    border-radius: 3px;
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .grade-strong {
    background: var(--color-paper-sage-text);
    color: #fff;
  }

  .grade-weak {
    background: var(--color-hour);
    color: var(--color-ink);
  }

  .silent-note {
    margin: 10px 0 0;
    border-radius: 999px;
    background: var(--color-paper-chip);
    padding: 6px 9px;
    text-align: center;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .week-desk:hover .backing-one {
      transform: translate(-14px, 10px) rotate(-6.6deg);
    }

    .week-desk:hover .backing-two {
      transform: translate(5px, 5px) rotate(3.6deg);
    }

    .week-desk:hover .card-full {
      box-shadow: var(--shadow-paper-card-hover);
      transform: translate(-4px, 2px) rotate(-2.9deg);
    }

    .week-desk:hover .card-thin {
      box-shadow: var(--shadow-paper-card-hover);
      transform: translate(5px, -7px) rotate(2.3deg);
    }
  }

  @media (max-width: 1100px) {
    .desk-ref {
      display: none;
    }

    .card-full,
    .card-thin {
      padding-inline: 13px;
    }

    .card-full {
      width: 57%;
      padding-right: 32px;
    }

    .sheet-backing {
      width: 55%;
    }

    .card-thin {
      width: 48%;
    }
  }
</style>

<script>
  import "../../scripts/art";
</script>
