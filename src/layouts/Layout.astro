---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StageRail from "../components/StageRail.astro";

interface Props {
  title: string;
  description: string;
  /** Le rail suit les étapes CRM du mandat client raconté par l'accueil. Sur une
   *  page qui ne raconte pas ce mandat, `LEAD → COMPLETED` ne décrit plus rien :
   *  c'est alors une décoration, ce que le rail n'a jamais été. */
  rail?: boolean;
  /** Dégagement des ancres internes. Le défaut de `global.css` (80px) couvre la
   *  barre de nav seule ; une page qui empile une seconde barre collante sous
   *  elle — la barre de saut de `/product` — doit déclarer la somme, sinon
   *  l'ancre gare son titre DERRIÈRE. Posé en variable inline plutôt qu'en
   *  `<style is:global>` dans la page : le style ne peut alors pas fuir vers un
   *  autre document au moment où Astro regroupe les feuilles. */
  scrollPad?: string;
}

const { title, description, rail = true, scrollPad } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en" style={scrollPad ? `--scroll-pad:${scrollPad}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Polices auto-hébergées : préchargées, aucune requête tierce. */}
    <link rel="preload" href="/fonts/cabinet-grotesk-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[6px] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    {rail && <StageRail />}
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
